# Root env file — used by docker-compose.prod.yml (see `## Deploy` in README.md). The dev workflow
# (npm run dev / server:dev) doesn't read this file; server/.env.example covers that instead.
#
# Copy to .env, fill in real values, then: docker compose -f docker-compose.prod.yml up -d --build

# --- Postgres (the `postgres` and `backup` services) ---
POSTGRES_DB=edunova
POSTGRES_USER=edunova
POSTGRES_PASSWORD=change_me_to_a_long_random_value

# --- API (the `api` service — see server/.env.example for what each var does) ---
JWT_SECRET=change_me_to_a_long_random_value
CORS_ORIGIN=http://localhost
LOG_LEVEL=info

# Phase 9 integrations — all optional, each feature degrades gracefully (logs/no-ops) when unset.
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# MSG91_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:admin@edunova.in"

# --- nginx (the `nginx` service) ---
# Host port the SPA + proxied API are published on.
HTTP_PORT=80
