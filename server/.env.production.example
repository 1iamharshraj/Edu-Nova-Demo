# Production-flavored reference for the `api` container's env. In the shipped docker-compose.prod.yml
# these are set directly by Compose from the root .env (see docker-compose.prod.yml's `api.environment`
# and the root .env.example) — that's the path most deployments should use, and this file is not read
# by anything automatically. Keep this around for the one case Compose doesn't cover: running the built
# image (or `node dist/server/src/index.js` directly) outside Compose, where you'd load these into the
# environment yourself (e.g. `--env-file server/.env.production`).

# Postgres reachable from wherever this process runs — inside docker-compose.prod.yml that's the
# `postgres` service on its internal network, not the dev port 5434.
DATABASE_URL="postgresql://edunova:REPLACE_ME@postgres:5432/edunova?schema=public"

# Long, random, unique to this deployment. Rotating it invalidates every existing session.
JWT_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_SECRET"

PORT=4000

# The public origin the SPA is served from (nginx). Same-origin deployments (the default — nginx
# proxies /api) don't strictly need this for browser requests, but keep it accurate for anything
# hitting the API directly.
CORS_ORIGIN="https://your-school-domain.example"

LOG_LEVEL=info

# --- Phase 9 integrations — all optional, each degrades gracefully (logs/no-ops) when unset ---
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# MSG91_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:admin@your-school-domain.example"
