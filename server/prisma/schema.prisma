generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]

  // Phase 28 — multi-school/group management. Nullable/additive: most schools are standalone. A
  // SchoolGroup is NOT itself a tenant — it has no classes/students/staff of its own, see
  // phase-28-multi-school-group.md §1. onDelete: SetNull so deleting a SchoolGroup (not currently exposed
  // via any endpoint) never cascades into deleting real school data.
  groupId String?
  group   SchoolGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  years         AcademicYear[]
  terms         Term[]
  boards        Board[]
  grades        Grade[]
  streams       Stream[]
  curriculum    CurriculumSubject[]
  classes       Class[]
  subjects      Subject[]
  classSubjects ClassSubject[]
  rooms         Room[]
  enrollments   Enrollment[]
  guardians     Guardian[]
  auditLogs     AuditLog[]

  periodTemplates    PeriodTemplate[]
  timetableEntries   TimetableEntry[]
  timetablePublishes TimetablePublish[]
  substitutions      Substitution[]

  files              File[]
  attendanceSessions AttendanceSession[]
  staffAttendance    StaffAttendance[]
  gradeScales        GradeScale[]
  assessments        Assessment[]
  homework           Homework[]

  applications        Application[]
  certificates        Certificate[]
  boardRegistrations  BoardRegistration[]
  parentVerifications ParentVerification[]

  feeHeads            FeeHead[]
  feeStructures       FeeStructure[]
  feeInvoices         FeeInvoice[]
  payments            Payment[]
  feeReminders        FeeReminder[]
  salaryStructures    SalaryStructure[]
  payslips            Payslip[]
  feeInstallmentPlans FeeInstallmentPlan[]
  scholarships        Scholarship[]
  scholarshipAwards   ScholarshipAward[]

  leaveTypes    LeaveType[]
  leaveRequests LeaveRequest[]
  contracts     Contract[]
  resignations  Resignation[]
  duties        Duty[]

  posts          Post[]
  conversations  Conversation[]
  notifications  Notification[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]

  healthRecords     HealthRecord[]
  permissionSlips   PermissionSlip[]
  achievements      Achievement[]
  disciplinaryCases DisciplinaryCase[]
  callLogs          CallLog[]
  activities        Activity[]
  housePoints       HousePoints[]

  aiConversations     AiConversation[]
  generatedWorksheets GeneratedWorksheet[]
  highlights          Highlight[]

  // Phase 11 — employee management (A3-A6).
  performanceReviews  PerformanceReview[]
  employmentHistory   EmploymentHistoryEntry[]
  staffConductRecords StaffConductRecord[]
  employeeDocuments   EmployeeDocument[]

  // Phase 12 — transport / bus management.
  transportRoutes        Route[]
  transportStops         Stop[]
  vehicles               Vehicle[]
  studentStopAssignments StudentStopAssignment[]
  vehicleLocations       VehicleLocation[]

  // Phase 13 — alumni management.
  alumniProfiles  AlumniProfile[]
  alumniEvents    AlumniEvent[]
  alumniDonations AlumniDonation[]

  // Phase 14 — hostel management.
  hostels           Hostel[]
  hostelRooms       HostelRoom[]
  hostelBeds        HostelBed[]
  hostelAllocations HostelAllocation[]

  // Phase 24 — hostel outpass / roll-call / mess menu extensions. HostelRollCallEntry has no schoolId of
  // its own (like AttendanceRecord) — scoped via its HostelRollCall.
  hostelOutpasses HostelOutpass[]
  hostelRollCalls HostelRollCall[]
  messMenus       MessMenu[]
  mealFeedback    MealFeedback[]

  // Phase 15 — library management.
  books           Book[]
  bookCopies      BookCopy[]
  loans           Loan[]
  librarySettings LibrarySettings?

  // Phase 16 — inventory / procurement.
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  vendors        Vendor[]
  purchaseOrders PurchaseOrder[]

  // Phase 17 — accounting / general ledger.
  accounts       Account[]
  journalEntries JournalEntry[]

  // Phase 18 — syllabus & teaching progress tracking.
  syllabusChapters    SyllabusChapter[]
  chapterProgress     ChapterProgress[]
  termSyllabusTargets TermSyllabusTarget[]
  chapterResources    ChapterResource[]

  // Phase 19 — early warning & teaching analytics.
  studentRiskSnapshots StudentRiskSnapshot[]
  analyticsSettings    AnalyticsSettings?

  // Phase 22 — campus safety & security.
  authorizedPickupPeople AuthorizedPickupPerson[]
  pickupEvents           PickupEvent[]
  visitors               Visitor[]
  counselingRecords      CounselingRecord[]
  counselingSettings     CounselingSettings?
  anonymousReports       AnonymousReport[]
  medicationSchedules    MedicationSchedule[]
  medicationLogs         MedicationLog[]

  // Phase 23 — parent experience (family summary / daily digest / WhatsApp channel).
  parentDigestSends ParentDigestSend[]

  // Phase 25 — exam operations.
  examSeatingPlans   ExamSeatingPlan[]
  invigilationDuties InvigilationDuty[]
  studentWallets     StudentWallet[]
  walletTransactions WalletTransaction[]

  // Phase T1 — advanced timetable generation, scheduling data-model foundations. See
  // phase-t1-timetable-foundations.md. Purely additive: Cohort layers on top of Class (D2), Capability/
  // RoomCapability is a normalized catalog on top of Room, TeacherQualification supersedes nothing (it
  // sits alongside the existing ClassSubject.teacherId signal), WorkingDayPattern is new school/year config.
  cohorts               Cohort[]
  capabilities          Capability[]
  teacherQualifications TeacherQualification[]
  workingDayPatterns    WorkingDayPattern[]

  // Phase T2 — strong admissions (Part A data expansion + Part B document/custody management). See
  // phase-t2-strong-admissions.md. AdmissionCategory/RequiredDocumentType are school-editable catalogs;
  // SubmittedDocument/PriorSubjectScore are per-application(/student) rows; AdmissionSettings is the usual
  // 1:1 settings row (matches LibrarySettings/AnalyticsSettings/CounselingSettings convention).
  admissionCategories   AdmissionCategory[]
  requiredDocumentTypes RequiredDocumentType[]
  submittedDocuments    SubmittedDocument[]
  priorSubjectScores    PriorSubjectScore[]
  admissionSettings     AdmissionSettings?

  // Phase T3 — sectioning engine. See phase-t3-sectioning-engine.md. Purely additive on top of T1's
  // Cohort: PerformanceBand/SectioningTemplate drive the 6 banding strategies; CohortMembership is the
  // new student-level junction needed for TRACK-type cohorts (a track spans base classes but only some of
  // their students, unlike the 1:1 SECTION cohort which is class-level via CohortClass); TrackEligibilityRule/
  // TrackEligibilityException back the two-stage track pipeline (D5); SectioningVersion/SectioningAssignment
  // are the versioned draft->approve pipeline (§4).
  performanceBands           PerformanceBand[]
  sectioningTemplates        SectioningTemplate[]
  cohortMemberships          CohortMembership[]
  trackEligibilityRules      TrackEligibilityRule[]
  trackEligibilityExceptions TrackEligibilityException[]
  sectioningVersions         SectioningVersion[]
  sectioningAssignments      SectioningAssignment[]

  // Phase T4 — Constraint Builder + solver core. See phase-t4-solver-core.md. Purely additive: extends
  // T1's Cohort with a declared per-subject teaching need (TeachingRequirement), a Fixed-mode teacher
  // assignment (TeachingAssignment), and a real queryable constraint table (Constraint) the new
  // cohort-scoped generation path (modules/timetable/solver.ts) reads and applies.
  teachingRequirements TeachingRequirement[]
  teachingAssignments  TeachingAssignment[]
  constraints          Constraint[]

  // Phase T5 — full assignment modes + soft constraints. See phase-t5-full-solver.md. Purely additive:
  // TeacherAvailability backfills the T1-promised-but-never-shipped per-day/period availability signal
  // (confirmed missing from the actual T1 migration — see modules/timetable/constraints.ts's own note);
  // TeachingAssignmentPool backs Mode 2 (Pool); Preference/PreferenceProfile back the soft-constraint
  // scoring + SA refinement engine and the 7 named starting profiles.
  teacherAvailabilities  TeacherAvailability[]
  teachingAssignmentPool TeachingAssignmentPool[]
  preferences            Preference[]
  preferenceProfiles     PreferenceProfile[]

  // Phase T6 — sessions, generation jobs, diagnostics. See phase-t6-sessions-jobs.md. Purely additive:
  // TimetableSession/TimetableSessionEntry/SessionCohort formalize the "one session can satisfy multiple
  // linked cohorts at once" SharedSession concept (roadmap D3); ElectiveBlock/ElectiveOffering/
  // ElectiveChoice model a grade-wide reserved slot with parallel elective offerings students individually
  // choose between (T3's Activity/registration pattern, reused in shape); TimetableGenerationJob wraps
  // T4/T5's existing generate->refine pipeline as a first-class, reproducible, diagnosable object.
  timetableSessions       TimetableSession[]
  timetableGenerationJobs TimetableGenerationJob[]
  electiveBlocks          ElectiveBlock[]

  // Phase T7 — versioning, locks, override system. See phase-t7-versioning-override.md.
  timetableVersions   TimetableVersion[]
  timetableLocks      TimetableLock[]
  timetableEditEvents TimetableEditEvent[]

  // Phase T9 — substitution workflow. See phase-t9-substitution.md. Purely additive on top of the
  // existing Phase 6 LeaveRequest (extended with a PENDING_SUBSTITUTION status value, not forked) and the
  // existing Phase 2 Substitution (still the real "this date, this period, this substitute" record the
  // rest of the app reads — see substitution.ts's own doc comment for why T9 writes Substitution rows
  // rather than a parallel structure).
  substitutionPolicy   SubstitutionPolicy?
  substitutionRequests SubstitutionRequest[]
  periodHolds          PeriodHold[]
}

model User {
  id                 String  @id
  schoolId           String
  school             School  @relation(fields: [schoolId], references: [id])
  role               String
  name               String
  email              String  @unique
  passwordHash       String
  mustChangePassword Boolean @default(false)
  title              String
  avatarHue          Int
  verified           Boolean @default(false)
  active             Boolean @default(true)

  // Real (still-editable) profile fields — not derived from academic entities.
  department  String?
  designation String?
  reportsTo   String?
  manager     User?   @relation("Reports", fields: [reportsTo], references: [id], onDelete: SetNull)
  reports     User[]  @relation("Reports")
  joinDate    String?
  phone       String?
  dob         String?

  // Phase 4 profile / identity fields.
  photoFileId      String?
  emergencyContact String?
  address          String?
  lastLoginAt      DateTime?

  // Phase 11 — employee ID (teacher/staff/admin/superadmin only; see A1).
  employeeId String? @unique

  // Phase 22 — item 3 (confidential counseling). Admin-settable capability flag; gates the entire
  // modules/counseling/ module. See modules/counseling/service.ts — deliberately a boolean, not a
  // designation-string match (fragile) and not a new Role (counselors keep their existing teacher/staff
  // role, this is an additive capability on top).
  isCounselor Boolean @default(false)

  // Phase T1 — teacher band affinity (§4 / roadmap D2 groundwork for T5's Mode-4 optimizer). Teacher-role
  // only in practice, but kept on the shared User table per this codebase's existing convention of
  // role-conditional fields (see e.g. isCounselor above). Shape for both JSON fields:
  // { support: 'STRONG'|'MEDIUM'|'NONE', mid: ..., advanced: ... }. `verifiedBandAffinity` stays null until
  // the future T11 evaluation engine populates it; `affinitySource` records which one is authoritative.
  declaredBandAffinity Json?
  verifiedBandAffinity Json?
  affinitySource       String @default("DECLARED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments      Enrollment[]
  wardLinks        Guardian[]       @relation("GuardianParent")
  guardianLinks    Guardian[]       @relation("GuardianStudent")
  teaching         ClassSubject[]
  classTeacherOf   Class[]
  timetableEntries TimetableEntry[]
  substitutions    Substitution[]

  uploads               File[]
  attendanceMarked      AttendanceSession[]  @relation("SessionMarkedBy")
  attendanceRecords     AttendanceRecord[]
  staffAttendance       StaffAttendance[]    @relation("StaffAttendanceUser")
  staffAttendanceMarked StaffAttendance[]    @relation("StaffAttendanceMarkedBy")
  marks                 Mark[]
  homeworkCreated       Homework[]
  homeworkSubmissions   HomeworkSubmission[]

  applicationsAsStudent    Application[]        @relation("ApplicationStudent")
  applicationsSubmitted    Application[]        @relation("ApplicationSubmittedBy")
  applicationsDecided      Application[]        @relation("ApplicationDecidedBy")
  applicationsAsSibling    Application[]        @relation("ApplicationSibling")
  submittedDocuments       SubmittedDocument[]  @relation("SubmittedDocumentStudent")
  submittedDocumentsLogged SubmittedDocument[]  @relation("SubmittedDocumentSubmittedBy")
  certificatesAsStudent    Certificate[]        @relation("CertificateStudent")
  certificatesIssued       Certificate[]        @relation("CertificateIssuedBy")
  boardRegistrations       BoardRegistration[]  @relation("BoardRegStudent")
  boardRegsValidated       BoardRegistration[]  @relation("BoardRegValidatedBy")
  passwordResets           PasswordReset[]
  parentVerification       ParentVerification?  @relation("VerificationParent")
  verificationsDone        ParentVerification[] @relation("VerificationVerifiedBy")

  feeInvoices        FeeInvoice[]     @relation("FeeInvoiceStudent")
  paymentsRecorded   Payment[]        @relation("PaymentRecordedBy")
  feeRemindersSent   FeeReminder[]    @relation("FeeReminderSentBy")
  salaryStructure    SalaryStructure? @relation("SalaryStructureUser")
  payslips           Payslip[]        @relation("PayslipUser")
  payslipsMarkedPaid Payslip[]        @relation("PayslipPaidBy")

  leaveRequestsMade    LeaveRequest[] @relation("LeaveRequester")
  leaveRequestsFor     LeaveRequest[] @relation("LeaveForUser")
  leaveRequestsDecided LeaveRequest[] @relation("LeaveDecidedBy")
  contracts            Contract[]     @relation("ContractUser")
  contractsAdminSigned Contract[]     @relation("ContractAdminSignedBy")
  resignations         Resignation[]  @relation("ResignationUser")
  resignationsDecided  Resignation[]  @relation("ResignationDecidedBy")
  dutiesAssigned       Duty[]         @relation("DutyAssignee")
  dutiesCreated        Duty[]         @relation("DutyCreatedBy")

  postsAuthored         Post[]          @relation("PostAuthor")
  postReactions         PostReaction[]
  postComments          PostComment[]
  conversationsCreated  Conversation[]  @relation("ConversationCreatedBy")
  participations        Participant[]
  messagesSent          Message[]
  notifications         Notification[]
  meetingsRequested     Meeting[]       @relation("MeetingRequester")
  meetingsWith          Meeting[]       @relation("MeetingWithUser")
  meetingsAsStudent     Meeting[]       @relation("MeetingStudent")
  meetingsDecided       Meeting[]       @relation("MeetingDecidedBy")
  calendarEventsCreated CalendarEvent[] @relation("CalendarEventCreatedBy")

  healthRecordsAsStudent HealthRecord[]         @relation("HealthRecordStudent")
  healthRecordsAdded     HealthRecord[]         @relation("HealthRecordAddedBy")
  healthRecordsVerified  HealthRecord[]         @relation("HealthRecordVerifiedBy")
  slipsCreated           PermissionSlip[]       @relation("SlipCreatedBy")
  slipResponsesAsStudent SlipResponse[]         @relation("SlipResponseStudent")
  slipResponsesAsParent  SlipResponse[]         @relation("SlipResponseParent")
  achievementsOwned      Achievement[]          @relation("AchievementUser")
  achievementsVerified   Achievement[]          @relation("AchievementVerifiedBy")
  disciplinaryAsStudent  DisciplinaryCase[]     @relation("DisciplinaryCaseStudent")
  disciplinaryReported   DisciplinaryCase[]     @relation("DisciplinaryCaseReportedBy")
  disciplinaryNotes      DisciplinaryNote[]     @relation("DisciplinaryNoteAuthor")
  callLogsAsStudent      CallLog[]              @relation("CallLogStudent")
  callLogsAsParent       CallLog[]              @relation("CallLogParent")
  callLogsMade           CallLog[]              @relation("CallLogBy")
  activitiesCreated      Activity[]             @relation("ActivityCreatedBy")
  activityRegistrations  ActivityRegistration[] @relation("ActivityRegistrationUser")
  housePointsAwarded     HousePoints[]          @relation("HousePointsAwardedBy")

  aiConversations         AiConversation[]     @relation("AiConversationStudent")
  generatedWorksheetsMade GeneratedWorksheet[] @relation("GeneratedWorksheetCreatedBy")
  highlightsCreated       Highlight[]          @relation("HighlightCreatedBy")
  pushSubscriptions       PushSubscription[]   @relation("PushSubscriptionUser")

  sessions Session[]

  // Phase 11 — employee management (A3-A6).
  reviewsAsEmployee       PerformanceReview[]      @relation("ReviewEmployee")
  reviewsAsReviewer       PerformanceReview[]      @relation("ReviewReviewer")
  employmentHistory       EmploymentHistoryEntry[] @relation("EmploymentHistoryUser")
  employmentHistoryLogged EmploymentHistoryEntry[] @relation("EmploymentHistoryChangedBy")
  staffConductAsEmployee  StaffConductRecord[]     @relation("ConductEmployee")
  staffConductReported    StaffConductRecord[]     @relation("ConductReportedBy")
  staffConductResolved    StaffConductRecord[]     @relation("ConductResolvedBy")
  employeeDocuments       EmployeeDocument[]       @relation("EmployeeDocumentUser")
  employeeDocumentsAdded  EmployeeDocument[]       @relation("EmployeeDocumentUploadedBy")

  // Phase 12 — transport / bus management. `driverUserId` on Vehicle is an OPTIONAL link to an existing
  // staff/teacher/admin account (not a new "driver" role) — see phase-12-transport.md.
  vehiclesAsDriver         Vehicle[]               @relation("VehicleDriverUser")
  stopAssignmentsAsStudent StudentStopAssignment[] @relation("StopAssignmentStudent")

  // Phase 13 — alumni management. `studentUserId` on AlumniProfile is an OPTIONAL link back to the
  // original student account — see phase-13-alumni.md and modules/alumni/service.ts#convertStudent.
  alumniProfileAsStudent  AlumniProfile[]  @relation("AlumniProfileStudent")
  alumniProfilesAdded     AlumniProfile[]  @relation("AlumniProfileConvertedBy")
  alumniEventsCreated     AlumniEvent[]    @relation("AlumniEventCreatedBy")
  alumniDonationsRecorded AlumniDonation[] @relation("AlumniDonationRecordedBy")

  // Phase 14 — hostel management. `wardenUserId` on Hostel is an OPTIONAL link to an existing
  // staff/teacher/admin account (not a new "warden" role) — see phase-14-hostel.md.
  hostelsAsWarden            Hostel[]           @relation("HostelWarden")
  hostelAllocationsAsStudent HostelAllocation[] @relation("HostelAllocationStudent")
  hostelAllocationsMade      HostelAllocation[] @relation("HostelAllocationAllocatedBy")

  // Phase 24 — hostel outpass / roll-call / mess menu extensions. See phase-24-boarding-hostel-extensions.md.
  hostelOutpassesAsStudent HostelOutpass[]  @relation("HostelOutpassStudent")
  hostelOutpassesRequested HostelOutpass[]  @relation("HostelOutpassRequestedBy")
  hostelOutpassesApproved  HostelOutpass[]  @relation("HostelOutpassApprovedBy")
  hostelRollCallsRecorded  HostelRollCall[] @relation("HostelRollCallRecordedBy")
  messMenusCreated         MessMenu[]       @relation("MessMenuCreatedBy")
  mealFeedbackAsStudent    MealFeedback[]   @relation("MealFeedbackStudent")

  // Phase 15 — library management. `borrowerId` on Loan is a student OR staff/teacher account (whoever
  // borrowed the book) — see phase-15-library.md.
  loansAsBorrower Loan[] @relation("LoanBorrower")
  loansIssued     Loan[] @relation("LoanIssuedBy")
  loansReturned   Loan[] @relation("LoanReturnedBy")

  // Phase 16 — inventory / procurement.
  stockMovementsRecorded StockMovement[] @relation("StockMovementRecordedBy")
  purchaseOrdersCreated  PurchaseOrder[] @relation("PurchaseOrderCreatedBy")

  // Phase 17 — accounting / general ledger.
  journalEntriesCreated JournalEntry[] @relation("JournalEntryCreatedBy")

  // Phase 18 — syllabus & teaching progress tracking.
  chapterProgressUpdated ChapterProgress[] @relation("ChapterProgressUpdatedBy")
  chapterResourcesAdded  ChapterResource[] @relation("ChapterResourceUploadedBy")

  // Phase 19 — early warning & teaching analytics.
  riskSnapshotsAsStudent StudentRiskSnapshot[] @relation("StudentRiskSnapshotStudent")

  // Phase 21 — financial intelligence: formal scholarship program.
  scholarshipAwardsAsStudent ScholarshipAward[] @relation("ScholarshipAwardStudent")
  scholarshipAwardsProposed  ScholarshipAward[] @relation("ScholarshipAwardProposedBy")
  scholarshipAwardsApproved  ScholarshipAward[] @relation("ScholarshipAwardApprovedBy")

  // Phase 22 — campus safety & security. See phase-22-campus-safety.md.
  authorizedPickupPeopleAdded  AuthorizedPickupPerson[] @relation("AuthorizedPickupPersonAddedBy")
  pickupPeopleAsStudent        AuthorizedPickupPerson[] @relation("AuthorizedPickupPersonStudent")
  pickupEventsAsStudent        PickupEvent[]            @relation("PickupEventStudent")
  pickupEventsRecorded         PickupEvent[]            @relation("PickupEventRecordedBy")
  visitorsHosted               Visitor[]                @relation("VisitorHost")
  visitorsRecorded             Visitor[]                @relation("VisitorRecordedBy")
  counselingRecordsAsStudent   CounselingRecord[]       @relation("CounselingRecordStudent")
  counselingRecordsAsCounselor CounselingRecord[]       @relation("CounselingRecordCounselor")
  anonymousReportsReviewed     AnonymousReport[]        @relation("AnonymousReportReviewedBy")
  medicationSchedulesAsStudent MedicationSchedule[]     @relation("MedicationScheduleStudent")
  medicationSchedulesAdded     MedicationSchedule[]     @relation("MedicationScheduleAddedBy")
  medicationLogsAdministered   MedicationLog[]          @relation("MedicationLogAdministeredBy")
  parentDigestSends            ParentDigestSend[]       @relation("ParentDigestSendParent")

  // Phase 25 — exam operations.
  examSeatingPlansGenerated   ExamSeatingPlan[]  @relation("ExamSeatingPlanGeneratedBy")
  examSeatsAsStudent          ExamSeat[]         @relation("ExamSeatStudent")
  invigilationDutiesAsTeacher InvigilationDuty[] @relation("InvigilationDutyTeacher")

  // Phase T1 — teacher subject+grade-range qualifications (see phase-t1-timetable-foundations.md §3).
  teacherQualifications TeacherQualification[] @relation("TeacherQualificationTeacher")

  // Phase T4 — Fixed-mode teaching assignments (see phase-t4-solver-core.md §2).
  teachingAssignments TeachingAssignment[] @relation("TeachingAssignmentTeacher")

  // Phase T5 — per day/period availability + Mode-2 pool membership (see phase-t5-full-solver.md).
  teacherAvailabilities  TeacherAvailability[]    @relation("TeacherAvailabilityTeacher")
  teachingAssignmentPool TeachingAssignmentPool[] @relation("TeachingAssignmentPoolTeacher")

  // Phase 28 — multi-school/group management. A GroupAdmin grant is independent of this user's own
  // `schoolId` — see phase-28-multi-school-group.md §1 (a group-admin may be a trust-level employee with
  // no operational account at any single member school).
  groupAdminGrants GroupAdmin[] @relation("GroupAdminUser")

  // Phase 30 — canteen prepaid wallet. See phase-30-canteen-wallet.md. `studentWallet` is a nullable
  // one-to-one (lazily created on first top-up, see modules/canteen/service.ts#ensureWallet) — most users
  // (non-students) never have one.
  studentWallet              StudentWallet?
  walletTransactionsRecorded WalletTransaction[] @relation("WalletTransactionRecordedBy")

  // Phase T3 — sectioning engine. See phase-t3-sectioning-engine.md.
  cohortMemberships              CohortMembership[]          @relation("CohortMembershipStudent")
  trackExceptionsAsStudent       TrackEligibilityException[] @relation("TrackEligibilityExceptionStudent")
  trackExceptionsApproved        TrackEligibilityException[] @relation("TrackEligibilityExceptionApprovedBy")
  sectioningVersionsApproved     SectioningVersion[]         @relation("SectioningVersionApprovedBy")
  sectioningAssignmentsAsStudent SectioningAssignment[]      @relation("SectioningAssignmentStudent")

  // Phase T6 — sessions, generation jobs, diagnostics. See phase-t6-sessions-jobs.md.
  timetableSessionsAsTeacher     TimetableSession[]       @relation("TimetableSessionTeacher")
  timetableSessionsCreated       TimetableSession[]       @relation("TimetableSessionCreatedBy")
  timetableGenerationJobsCreated TimetableGenerationJob[] @relation("TimetableGenerationJobCreatedBy")
  electiveBlocksCreated          ElectiveBlock[]          @relation("ElectiveBlockCreatedBy")
  electiveChoicesAsStudent       ElectiveChoice[]         @relation("ElectiveChoiceStudent")

  // Phase T7 — versioning, locks, override system. See phase-t7-versioning-override.md.
  timetableVersionsCreated   TimetableVersion[]   @relation("TimetableVersionCreatedBy")
  timetableLocksCreated      TimetableLock[]      @relation("TimetableLockCreatedBy")
  timetableEditEventsCreated TimetableEditEvent[] @relation("TimetableEditEventCreatedBy")

  // Phase T9 — substitution workflow. See phase-t9-substitution.md.
  substitutionRequestsAsOriginalTeacher SubstitutionRequest[] @relation("SubstitutionRequestOriginalTeacher")
  substitutionRequestsAsSubstitute      SubstitutionRequest[] @relation("SubstitutionRequestSubstituteTeacher")
  substitutionRequestsSent              SubstitutionRequest[] @relation("SubstitutionRequestSentBy")
  substitutionRequestsDecided           SubstitutionRequest[] @relation("SubstitutionRequestDecidedBy")
  periodHoldsAsTeacher                  PeriodHold[]          @relation("PeriodHoldTeacher")

  @@index([schoolId])
}

// ───────────────────────── Phase 1 academic entities ─────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  terms             Term[]
  scholarshipAwards ScholarshipAward[]
  classes           Class[]
  enrollments       Enrollment[]

  // Phase T1 — see phase-t1-timetable-foundations.md §1, §5.
  cohorts            Cohort[]
  workingDayPatterns WorkingDayPattern[]

  // Phase T3 — see phase-t3-sectioning-engine.md.
  performanceBands    PerformanceBand[]
  sectioningTemplates SectioningTemplate[]
  sectioningVersions  SectioningVersion[]

  // Phase T6 — see phase-t6-sessions-jobs.md §3.
  timetableGenerationJobs TimetableGenerationJob[]

  // Phase T7 — see phase-t7-versioning-override.md §1.
  timetableVersions TimetableVersion[]

  @@index([schoolId])
}

model Term {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  timetableEntries     TimetableEntry[]
  timetablePublishes   TimetablePublish[]
  assessments          Assessment[]
  feeStructures        FeeStructure[]
  feeInvoices          FeeInvoice[]
  calendarEvents       CalendarEvent[]
  termSyllabusTargets  TermSyllabusTarget[]
  studentRiskSnapshots StudentRiskSnapshot[]

  // Phase T6 — see phase-t6-sessions-jobs.md.
  timetableSessions       TimetableSession[]
  timetableGenerationJobs TimetableGenerationJob[]
  electiveBlocks          ElectiveBlock[]

  // Phase T7 — see phase-t7-versioning-override.md §1.
  timetableVersions TimetableVersion[]

  // Phase T9 — see phase-t9-substitution.md §3.
  periodHolds PeriodHold[]

  @@index([schoolId])
  @@index([academicYearId])
}

// ───────────────────── Phase 1b: boards, grades, streams, curriculum ─────────────────────

model Board {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  createdAt DateTime @default(now())

  curriculum                  CurriculumSubject[]
  classes                     Class[]
  gradeScales                 GradeScale[]
  applicationsAsPreviousBoard Application[]       @relation("ApplicationPreviousBoard")

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Grade {
