generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]

  years         AcademicYear[]
  terms         Term[]
  boards        Board[]
  grades        Grade[]
  streams       Stream[]
  curriculum    CurriculumSubject[]
  classes       Class[]
  subjects      Subject[]
  classSubjects ClassSubject[]
  rooms         Room[]
  enrollments   Enrollment[]
  guardians     Guardian[]
  auditLogs     AuditLog[]

  periodTemplates    PeriodTemplate[]
  timetableEntries   TimetableEntry[]
  timetablePublishes TimetablePublish[]
  substitutions      Substitution[]

  files              File[]
  attendanceSessions AttendanceSession[]
  staffAttendance    StaffAttendance[]
  gradeScales        GradeScale[]
  assessments        Assessment[]
  homework           Homework[]

  applications        Application[]
  certificates        Certificate[]
  boardRegistrations  BoardRegistration[]
  parentVerifications ParentVerification[]

  feeHeads         FeeHead[]
  feeStructures    FeeStructure[]
  feeInvoices      FeeInvoice[]
  payments         Payment[]
  feeReminders     FeeReminder[]
  salaryStructures SalaryStructure[]
  payslips         Payslip[]

  leaveTypes    LeaveType[]
  leaveRequests LeaveRequest[]
  contracts     Contract[]
  resignations  Resignation[]
  duties        Duty[]

  posts          Post[]
  conversations  Conversation[]
  notifications  Notification[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]

  healthRecords     HealthRecord[]
  permissionSlips   PermissionSlip[]
  achievements      Achievement[]
  disciplinaryCases DisciplinaryCase[]
  callLogs          CallLog[]
  activities        Activity[]

  aiConversations AiConversation[]
  highlights      Highlight[]
}

model User {
  id                 String  @id
  schoolId           String
  school             School  @relation(fields: [schoolId], references: [id])
  role               String
  name               String
  email              String  @unique
  passwordHash       String
  mustChangePassword Boolean @default(false)
  title              String
  avatarHue          Int
  verified           Boolean @default(false)
  active             Boolean @default(true)

  // Real (still-editable) profile fields — not derived from academic entities.
  department  String?
  designation String?
  reportsTo   String?
  joinDate    String?
  phone       String?
  dob         String?

  // Phase 4 profile / identity fields.
  photoFileId      String?
  emergencyContact String?
  address          String?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments      Enrollment[]
  wardLinks        Guardian[]       @relation("GuardianParent")
  guardianLinks    Guardian[]       @relation("GuardianStudent")
  teaching         ClassSubject[]
  classTeacherOf   Class[]
  timetableEntries TimetableEntry[]
  substitutions    Substitution[]

  uploads               File[]
  attendanceMarked      AttendanceSession[]  @relation("SessionMarkedBy")
  attendanceRecords     AttendanceRecord[]
  staffAttendance       StaffAttendance[]    @relation("StaffAttendanceUser")
  staffAttendanceMarked StaffAttendance[]    @relation("StaffAttendanceMarkedBy")
  marks                 Mark[]
  homeworkCreated       Homework[]
  homeworkSubmissions   HomeworkSubmission[]

  applicationsAsStudent Application[]        @relation("ApplicationStudent")
  applicationsSubmitted Application[]        @relation("ApplicationSubmittedBy")
  applicationsDecided   Application[]        @relation("ApplicationDecidedBy")
  certificatesAsStudent Certificate[]        @relation("CertificateStudent")
  certificatesIssued    Certificate[]        @relation("CertificateIssuedBy")
  boardRegistrations    BoardRegistration[]  @relation("BoardRegStudent")
  boardRegsValidated    BoardRegistration[]  @relation("BoardRegValidatedBy")
  passwordResets        PasswordReset[]
  parentVerification    ParentVerification?  @relation("VerificationParent")
  verificationsDone     ParentVerification[] @relation("VerificationVerifiedBy")

  feeInvoices        FeeInvoice[]     @relation("FeeInvoiceStudent")
  paymentsRecorded   Payment[]        @relation("PaymentRecordedBy")
  feeRemindersSent   FeeReminder[]    @relation("FeeReminderSentBy")
  salaryStructure    SalaryStructure? @relation("SalaryStructureUser")
  payslips           Payslip[]        @relation("PayslipUser")
  payslipsMarkedPaid Payslip[]        @relation("PayslipPaidBy")

  leaveRequestsMade    LeaveRequest[] @relation("LeaveRequester")
  leaveRequestsFor     LeaveRequest[] @relation("LeaveForUser")
  leaveRequestsDecided LeaveRequest[] @relation("LeaveDecidedBy")
  contracts            Contract[]     @relation("ContractUser")
  contractsAdminSigned Contract[]     @relation("ContractAdminSignedBy")
  resignations         Resignation[]  @relation("ResignationUser")
  resignationsDecided  Resignation[]  @relation("ResignationDecidedBy")
  dutiesAssigned       Duty[]         @relation("DutyAssignee")
  dutiesCreated        Duty[]         @relation("DutyCreatedBy")

  postsAuthored         Post[]          @relation("PostAuthor")
  postReactions         PostReaction[]
  postComments          PostComment[]
  conversationsCreated  Conversation[]  @relation("ConversationCreatedBy")
  participations        Participant[]
  messagesSent          Message[]
  notifications         Notification[]
  meetingsRequested     Meeting[]       @relation("MeetingRequester")
  meetingsWith          Meeting[]       @relation("MeetingWithUser")
  meetingsAsStudent     Meeting[]       @relation("MeetingStudent")
  meetingsDecided       Meeting[]       @relation("MeetingDecidedBy")
  calendarEventsCreated CalendarEvent[] @relation("CalendarEventCreatedBy")

  healthRecordsAsStudent HealthRecord[]         @relation("HealthRecordStudent")
  healthRecordsAdded     HealthRecord[]         @relation("HealthRecordAddedBy")
  healthRecordsVerified  HealthRecord[]         @relation("HealthRecordVerifiedBy")
  slipsCreated           PermissionSlip[]       @relation("SlipCreatedBy")
  slipResponsesAsStudent SlipResponse[]         @relation("SlipResponseStudent")
  slipResponsesAsParent  SlipResponse[]         @relation("SlipResponseParent")
  achievementsOwned      Achievement[]          @relation("AchievementUser")
  achievementsVerified   Achievement[]          @relation("AchievementVerifiedBy")
  disciplinaryAsStudent  DisciplinaryCase[]     @relation("DisciplinaryCaseStudent")
  disciplinaryReported   DisciplinaryCase[]     @relation("DisciplinaryCaseReportedBy")
  disciplinaryNotes      DisciplinaryNote[]     @relation("DisciplinaryNoteAuthor")
  callLogsAsStudent      CallLog[]              @relation("CallLogStudent")
  callLogsAsParent       CallLog[]              @relation("CallLogParent")
  callLogsMade           CallLog[]              @relation("CallLogBy")
  activitiesCreated      Activity[]             @relation("ActivityCreatedBy")
  activityRegistrations  ActivityRegistration[] @relation("ActivityRegistrationUser")

  aiConversations   AiConversation[]   @relation("AiConversationStudent")
  highlightsCreated Highlight[]        @relation("HighlightCreatedBy")
  pushSubscriptions PushSubscription[] @relation("PushSubscriptionUser")

  sessions Session[]

  @@index([schoolId])
}

// ───────────────────────── Phase 1 academic entities ─────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  terms       Term[]
  classes     Class[]
  enrollments Enrollment[]

  @@index([schoolId])
}

model Term {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  timetableEntries   TimetableEntry[]
  timetablePublishes TimetablePublish[]
  assessments        Assessment[]
  feeStructures      FeeStructure[]
  feeInvoices        FeeInvoice[]
  calendarEvents     CalendarEvent[]

  @@index([schoolId])
  @@index([academicYearId])
}

// ───────────────────── Phase 1b: boards, grades, streams, curriculum ─────────────────────

model Board {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  createdAt DateTime @default(now())

  curriculum  CurriculumSubject[]
  classes     Class[]
  gradeScales GradeScale[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Grade {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label     String
  order     Int
  createdAt DateTime @default(now())

  curriculum CurriculumSubject[]
  classes    Class[]

  @@unique([schoolId, label])
  @@index([schoolId])
}

model Stream {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  curriculum CurriculumSubject[]
  classes    Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Which subjects a board teaches in a grade (optionally per stream). Uniqueness on
// (boardId, gradeId, streamId, subjectId) is enforced in the service because streamId is nullable.
model CurriculumSubject {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  gradeId     String
  grade       Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  streamId    String?
  stream      Stream?  @relation(fields: [streamId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  kind        String   @default("core")
  textbook    String?
  syllabusRef String?
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([boardId, gradeId])
}

model Class {
  id               String          @id @default(cuid())
  schoolId         String
  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  boardId          String
  board            Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  gradeId          String
  grade            Grade           @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  streamId         String?
  stream           Stream?         @relation(fields: [streamId], references: [id], onDelete: SetNull)
  section          String
  classTeacherId   String?
  classTeacher     User?           @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  capacity         Int?
  periodTemplateId String?
  periodTemplate   PeriodTemplate? @relation(fields: [periodTemplateId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  enrollments        Enrollment[]
  classSubjects      ClassSubject[]
  timetableEntries   TimetableEntry[]
  timetablePublishes TimetablePublish[]
  attendanceSessions AttendanceSession[]
  feeStructures      FeeStructure[]

  posts          Post[]
  conversations  Conversation[]
  calendarEvents CalendarEvent[]

  permissionSlips   PermissionSlip[]
  disciplinaryCases DisciplinaryCase[]
  highlights        Highlight[]

  @@unique([schoolId, academicYearId, boardId, gradeId, section])
  @@index([schoolId])
  @@index([classTeacherId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  color     String
  createdAt DateTime @default(now())

  classSubjects   ClassSubject[]
  curriculum      CurriculumSubject[]
  aiConversations AiConversation[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassSubject {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String?
  teacher        User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  periodsPerWeek Int      @default(5)
  createdAt      DateTime @default(now())

  timetableEntries TimetableEntry[]
  assessments      Assessment[]
  homework         Homework[]

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
}

model Room {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  kind      String   @default("classroom")
  capacity  Int?
  createdAt DateTime @default(now())

  timetableEntries TimetableEntry[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Enrollment {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  rollNo         String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  @@unique([studentId, academicYearId])
  @@index([schoolId])
  @@index([classId])
}

model Guardian {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User     @relation("GuardianParent", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("GuardianStudent", fields: [studentId], references: [id], onDelete: Cascade)
  relation  String   @default("guardian")
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

model AuditLog {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId  String
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([schoolId, at])
}

// ───────────────────────────── Phase 2: timetable ─────────────────────────────

// periods: [{ idx, label, start "HH:MM", end "HH:MM", kind "class" | "break" }]. Exactly one isDefault
// per school (service enforces); Class.periodTemplateId overrides it.
model PeriodTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  periods   Json
  createdAt DateTime @default(now())

  classes Class[]

  @@index([schoolId])
}

model TimetableEntry {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId         String
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 1 = Monday … 6 = Saturday
  periodIdx      Int
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teacherId      String?
  teacher        User?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  substitutions Substitution[]

  @@unique([classId, termId, dayOfWeek, periodIdx])
  @@index([schoolId, termId])
  @@index([teacherId])
  @@index([roomId])
}

model TimetablePublish {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId      String
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  publishedAt DateTime @default(now())

  @@unique([classId, termId])
  @@index([schoolId])
}

model Substitution {
  id                  String         @id @default(cuid())
  schoolId            String
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntryId    String
  timetableEntry      TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  date                DateTime       @db.Date
  substituteTeacherId String
  substituteTeacher   User           @relation(fields: [substituteTeacherId], references: [id], onDelete: Cascade)
  reason              String?
  createdAt           DateTime       @default(now())

  @@unique([timetableEntryId, date])
  @@index([schoolId, date])
  @@index([substituteTeacherId])
}

// ───────────────────── Phase 3: files, attendance, assessment, homework ─────────────────────

// Uploaded file; bytes live at server/uploads/<schoolId>/<id> (gitignored). `path` is that relative path.
model File {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  name       String
  mime       String
  size       Int
  path       String
  sha256     String
  createdAt  DateTime @default(now())

  highlightThumbnails Highlight[]

  @@index([schoolId])
}

// periodIdx null = whole-day attendance. Postgres treats NULL as distinct in the unique index, so the
// service enforces one day session per (classId, date) itself.
model AttendanceSession {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId    String
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  periodIdx  Int?
  markedById String?
  markedBy   User?     @relation("SessionMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  lockedAt   DateTime?
  createdAt  DateTime  @default(now())

  records AttendanceRecord[]

  @@unique([classId, date, periodIdx])
  @@index([schoolId, date])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String // P | A | L | E | H
  note      String?

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model StaffAttendance {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("StaffAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  status     String // P | A | L | H
  markedById String?
  markedBy   User?    @relation("StaffAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([userId, date])
  @@index([schoolId, date])
}

// bands: [{ min, grade, points? }] sorted desc by min. boardId null = school-wide fallback scale.
model GradeScale {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  boardId   String?
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: SetNull)
  bands     Json
  createdAt DateTime @default(now())

  @@index([schoolId])
}

model Assessment {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  termId         String
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  name           String
  maxMarks       Float
  weight         Float        @default(1)
  date           DateTime?    @db.Date
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())

  marks Mark[]

  @@index([schoolId])
  @@index([classSubjectId, termId])
}

model Mark {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float
  remark       String?
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model Homework {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  title          String
  description    String       @default("")
  dueDate        DateTime     @db.Date
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  attachments    String[]     @default([]) // File ids
  createdAt      DateTime     @default(now())

  submissions HomeworkSubmission[]

  @@index([schoolId])
  @@index([classSubjectId])
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt DateTime @default(now())
  files       String[] @default([]) // File ids
  note        String?
  status      String   @default("Submitted") // Submitted | Late | Graded | Returned
  grade       String?
  feedback    String?

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

// ───────────────────── Phase 4: admissions, certificates, identity ─────────────────────

// guardian: { name, phone?, email?, relation? }. studentId: the existing student for TC/Bonafide/Character;
// for Admission it is set when the application is approved (the student account that was created).
model Application {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind          String // Admission | TC | Bonafide | Character
  applicantName String
  dob           DateTime? @db.Date
  gender        String?
  guardian      Json?
  targetClassId String?
  targetBoardId String?
  studentId     String?
  student       User?     @relation("ApplicationStudent", fields: [studentId], references: [id], onDelete: SetNull)
  documents     String[]  @default([]) // File ids
  status        String    @default("Pending") // Pending | Verified | Approved | Declined
  notes         String?
  submittedById String?
  submittedBy   User?     @relation("ApplicationSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?     @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  certificates Certificate[]

  @@index([schoolId, status])
  @@index([studentId])
}

// serialNo: "EDN/TC/2026/0001" — sequential per school, kind and year (service allocates inside a transaction).
model Certificate {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind          String // TC | Bonafide | Character
  studentId     String
  student       User         @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  serialNo      String
  issuedById    String?
  issuedBy      User?        @relation("CertificateIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt      DateTime     @default(now())
  pdfFileId     String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([schoolId, serialNo])
  @@index([studentId])
}

model BoardRegistration {
  id                String    @id @default(cuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           User      @relation("BoardRegStudent", fields: [studentId], references: [id], onDelete: Cascade)
  boardId           String
  academicYearId    String
  registrationNo    String?
  rollNo            String?
  nameOnCertificate String
  dob               DateTime? @db.Date
  affiliationNo     String?
  status            String    @default("Draft") // Draft | Pending | Validated | SentToBoard
  validatedById     String?
  validatedBy       User?     @relation("BoardRegValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt       DateTime?
  sentAt            DateTime?
  mismatchNote      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([studentId, academicYearId])
  @@index([schoolId, status])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One record per parent; User.verified mirrors `status === "Verified"` (service keeps it in sync).
model ParentVerification {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId       String    @unique
  parent         User      @relation("VerificationParent", fields: [parentId], references: [id], onDelete: Cascade)
  method         String // Document | InPerson | Aadhaar
  status         String    @default("Pending") // Pending | Verified | Rejected
  documentFileId String?
  verifiedById   String?
  verifiedBy     User?     @relation("VerificationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt     DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([schoolId, status])
}

// ───────────────────────── Phase 5: finance (fees, payments, payroll) ─────────────────────────

model FeeHead {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([schoolId, name])
  @@index([schoolId])
}

// lines: [{ feeHeadId, amount }]
model FeeStructure {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  dueDate   DateTime @db.Date
  lines     Json
  createdAt DateTime @default(now())

  invoices FeeInvoice[]

  @@unique([classId, termId])
  @@index([schoolId])
}

// lines: [{ feeHeadId, name, amount }]. invoiceNo: "INV/2026/0001" — sequential per school + year.
// unique(studentId, feeStructureId): Postgres treats NULL as distinct, so ad-hoc invoices (feeStructureId
// null) don't collide; generate-invoices relies on this to be idempotent per structure.
model FeeInvoice {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        User          @relation("FeeInvoiceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  termId         String
  term           Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  lines          Json
  total          Float
  concession     Float         @default(0)
  dueDate        DateTime      @db.Date
  status         String        @default("Due") // Due | PartiallyPaid | Paid | Waived
  invoiceNo      String
  createdAt      DateTime      @default(now())

  payments  Payment[]
  reminders FeeReminder[]

  @@unique([studentId, feeStructureId])
  @@unique([schoolId, invoiceNo])
  @@index([schoolId])
  @@index([termId])
  @@index([studentId])
}

// receiptNo: "RCPT/2026/0001" — sequential per school + year.
model Payment {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Float
  method       String // UPI | Card | NetBanking | Cash | Cheque
  reference    String?
  paidAt       DateTime   @default(now())
  recordedById String?
  recordedBy   User?      @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  receiptNo    String
  note         String?

  @@unique([schoolId, receiptNo])
  @@index([invoiceId])
  @@index([schoolId])
}

model FeeReminder {
  id        String     @id @default(cuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentById  String?
  sentBy    User?      @relation("FeeReminderSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  channel   String // InApp | Email | SMS
  sentAt    DateTime   @default(now())
  note      String?

  @@index([invoiceId])
  @@index([schoolId])
}

// allowances/deductions: [{ name, amount }]
model SalaryStructure {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId        String   @unique
  user          User     @relation("SalaryStructureUser", fields: [userId], references: [id], onDelete: Cascade)
  basic         Float
  allowances    Json
  deductions    Json
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())

  @@index([schoolId])
}

// month: "2026-06". slipNo: "PAY/2026/0001" — sequential per school + year.
model Payslip {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("PayslipUser", fields: [userId], references: [id], onDelete: Cascade)
  month      String
  basic      Float
  allowances Json
  deductions Json
  gross      Float
  net        Float
  status     String    @default("Generated") // Generated | Paid
  paidAt     DateTime?
  paidById   String?
  paidBy     User?     @relation("PayslipPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  slipNo     String
  createdAt  DateTime  @default(now())

  @@unique([userId, month])
  @@unique([schoolId, slipNo])
  @@index([schoolId])
}

// ───────────────────────── Phase 6 HR (leave, contracts, resignations, duties) ─────────────────────────

// appliesTo: student | staff. daysPerYear 0 means unlimited (e.g. student leave).
model LeaveType {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  daysPerYear Int
  appliesTo   String
  createdAt   DateTime @default(now())

  requests LeaveRequest[]

  @@unique([schoolId, name, appliesTo])
  @@index([schoolId])
}

// days: computed on create, excluding Sundays in [fromDate, toDate].
model LeaveRequest {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requesterId  String
  requester    User       @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  forUserId    String
  forUser      User       @relation("LeaveForUser", fields: [forUserId], references: [id], onDelete: Cascade)
  leaveTypeId  String?
  leaveType    LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  fromDate     DateTime   @db.Date
  toDate       DateTime   @db.Date
  days         Int
  reason       String
  status       String     @default("Pending") // Pending | Approved | Declined | Cancelled
  decidedById  String?
  decidedBy    User?      @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime   @default(now())

  @@index([schoolId])
  @@index([forUserId])
}

model Contract {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation("ContractUser", fields: [userId], references: [id], onDelete: Cascade)
  designation      String
  department       String?
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  terms            String
  status           String    @default("Draft") // Draft | Active | Ended
  employeeSignedAt DateTime?
  adminSignedAt    DateTime?
  adminSignedById  String?
  adminSignedBy    User?     @relation("ContractAdminSignedBy", fields: [adminSignedById], references: [id], onDelete: SetNull)
  endedAt          DateTime?
  endReason        String?
  pdfFileId        String?
  createdAt        DateTime  @default(now())

  @@index([schoolId])
  @@index([userId])
}

model Resignation {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation("ResignationUser", fields: [userId], references: [id], onDelete: Cascade)
  reason          String
  submittedAt     DateTime  @default(now())
  lastWorkingDate DateTime  @db.Date
  status          String    @default("Pending") // Pending | Approved | Declined | Withdrawn
  decidedById     String?
  decidedBy       User?     @relation("ResignationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  notes           String?

  @@index([schoolId])
  @@index([userId])
}

model Duty {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  eventTitle  String
  eventDate   DateTime @db.Date
  assigneeId  String?
  assignee    User?    @relation("DutyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation("DutyCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  status      String   @default("Assigned") // Assigned | Done
  notes       String?
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([assigneeId])
}

// ───────────────────────── Phase 7 Communication (feed, messages, notifications, meetings, calendar) ─────────────────────────

// audience: School | Class | Role. classId set when audience=Class, role set when audience=Role.
model Post {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  audience     String
  classId      String?
  class        Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  role         String?
  title        String?
  body         String
  mediaFileIds String[] @default([])
  pinned       Boolean  @default(false)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  reactions PostReaction[]
  comments  PostComment[]

  @@index([schoolId])
  @@index([classId])
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

// kind: DM | Group. classId set for a class group conversation.
model Conversation {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind        String
  title       String?
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  participants Participant[]
  messages     Message[]

  @@index([schoolId])
  @@index([classId])
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  fileIds        String[]     @default([])
  sentAt         DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model Notification {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId])
  @@index([userId])
}

// status: Requested | Scheduled | Completed | Cancelled | Declined. link generated on Scheduled (Jitsi).
model Meeting {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User      @relation("MeetingRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  withUserId  String
  withUser    User      @relation("MeetingWithUser", fields: [withUserId], references: [id], onDelete: Cascade)
  studentId   String?
  student     User?     @relation("MeetingStudent", fields: [studentId], references: [id], onDelete: SetNull)
  purpose     String
  scheduledAt DateTime
  durationMin Int       @default(30)
  link        String?
  status      String    @default("Requested")
  decidedById String?
  decidedBy   User?     @relation("MeetingDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([schoolId])
  @@index([requesterId])
  @@index([withUserId])
}

// type: holiday | exam | event. audience: School | Class.
model CalendarEvent {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime  @db.Date
  endDate     DateTime? @db.Date
  type        String
  audience    String
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId      String?
  term        Term?     @relation(fields: [termId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User      @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([schoolId])
  @@index([classId])
}

// ── Phase 8 — welfare & compliance. See phase-8-welfare.md. ──

// kind: Vaccination|Allergy|Condition|Checkup|Other. Visible only to the student, guardians, class
// teacher, staff/admin (enforced in service, not schema).
model HealthRecord {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation("HealthRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  detail       String
  date         DateTime  @db.Date
  addedById    String
  addedBy      User      @relation("HealthRecordAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  verifiedById String?
  verifiedBy   User?     @relation("HealthRecordVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  fileIds      String[]  @default([])
  createdAt    DateTime  @default(now())

  @@index([schoolId])
  @@index([studentId])
}

// classId null = all classes. requiresVerifiedParent gates SlipResponse on the parent's `verified` flag.
model PermissionSlip {
  id                     String   @id @default(cuid())
  schoolId               String
  school                 School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title                  String
  detail                 String
  dueDate                DateTime @db.Date
  classId                String?
  class                  Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById            String
  createdBy              User     @relation("SlipCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  requiresVerifiedParent Boolean  @default(true)
  createdAt              DateTime @default(now())

  responses SlipResponse[]

  @@index([schoolId])
  @@index([classId])
}

// decision: Approved|Declined.
model SlipResponse {
  id          String         @id @default(cuid())
  slipId      String
  slip        PermissionSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  studentId   String
  student     User           @relation("SlipResponseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  parentId    String
  parent      User           @relation("SlipResponseParent", fields: [parentId], references: [id], onDelete: Cascade)
  decision    String
  respondedAt DateTime       @default(now())
  note        String?

  @@unique([slipId, studentId])
  @@index([slipId])
}

// category: Academic|Sports|Arts|Service|Other.
model Achievement {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("AchievementUser", fields: [userId], references: [id], onDelete: Cascade)
  title        String
  detail       String
  date         DateTime  @db.Date
  category     String
  verifiedById String?
  verifiedBy   User?     @relation("AchievementVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  fileIds      String[]  @default([])
  createdAt    DateTime  @default(now())

  @@index([schoolId])
  @@index([userId])
}

// status: Reported|Scheduled|Heard|Decision|Action Taken|Appealed|Closed. Soft delete via deletedAt
// (admin only) — excluded from default lists but kept for audit.
model DisciplinaryCase {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String
  student       User      @relation("DisciplinaryCaseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  classId       String?
  class         Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  title         String
  description   String
  reportedById  String
  reportedBy    User      @relation("DisciplinaryCaseReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  witnesses     String?
  fileIds       String[]  @default([])
  status        String    @default("Reported")
  hearingDate   DateTime?
  decision      String?
  actionTaken   String?
  appeal        String?
  relatedPeople String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  notes DisciplinaryNote[]

  @@index([schoolId])
  @@index([studentId])
}

// Status-change log + free-form notes on a disciplinary case.
model DisciplinaryNote {
  id        String           @id @default(cuid())
  caseId    String
  case      DisciplinaryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation("DisciplinaryNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime         @default(now())

  @@index([caseId])
}

// reason: fee|attendance|disciplinary|general. outcome: confirmed|callback|unreachable|refused|other.
// Replaces the AI call simulation — a real call staff/teacher/admin made and logged.
model CallLog {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("CallLogStudent", fields: [studentId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      User?    @relation("CallLogParent", fields: [parentId], references: [id], onDelete: SetNull)
  byId        String
  by          User     @relation("CallLogBy", fields: [byId], references: [id], onDelete: Cascade)
  reason      String
  summary     String
  outcome     String
  calledAt    DateTime @default(now())
  durationMin Int?

  @@index([schoolId])
  @@index([studentId])
}

// kind: club|house|exc|event|faculty. forRoles gates who may register; capacity → waitlist.
model Activity {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  description String
  capacity    Int?
  opensAt     DateTime?
  closesAt    DateTime?
  forRoles    String[]  @default([])
  createdById String
  createdBy   User      @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  registrations ActivityRegistration[]

  @@index([schoolId])
}

// status: Registered|Waitlisted|Cancelled.
model ActivityRegistration {
  id           String   @id @default(cuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("ActivityRegistrationUser", fields: [userId], references: [id], onDelete: Cascade)
  registeredAt DateTime @default(now())
  status       String   @default("Registered")

  @@unique([activityId, userId])
  @@index([activityId])
}

// ── Phase 9 — integrations & AI. See phase-9-10-integrations-hardening.md. ──

// One conversation thread per student (optionally scoped to a subject). Messages are the exchange with the
// Claude API; role is "user" | "assistant". Rate-limited to 30 user messages/day/student (see modules/ai).
model AiConversation {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("AiConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title     String?
  createdAt DateTime @default(now())

  messages AiMessage[]

  @@index([schoolId])
  @@index([studentId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// Event highlights CMS. url = YouTube/Drive link; audience mirrors CalendarEvent (School | Class).
model Highlight {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title           String
  url             String
  thumbnailFileId String?
  thumbnailFile   File?    @relation(fields: [thumbnailFileId], references: [id], onDelete: SetNull)
  audience        String
  classId         String?
  class           Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  publishedAt     DateTime @default(now())
  createdById     String
  createdBy       User     @relation("HighlightCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([schoolId])
  @@index([classId])
}

// Web Push subscriptions (PWA). One row per browser/device subscription for a user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("PushSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────────── Phase 10: hardening ─────────────────────────────

// Refresh-token sessions for JWT refresh (see phase-9-10-integrations-hardening.md → Phase 10 §2).
// Access tokens are short-lived (15 min); a Session row backs a longer-lived, rotating refresh token.
// Only a sha256 hash of the raw refresh token is ever stored.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Telephony (real outbound/inbound calling) is explicitly out of scope for Phase 9 — the Call log
// (Phase 8, modules/calls) is the shipped replacement for the old AI-call simulation. If real telephony
// is ever added, it would live here as a `modules/telephony` wrapper around a provider (Twilio/Exotel)
// following this same module pattern.
