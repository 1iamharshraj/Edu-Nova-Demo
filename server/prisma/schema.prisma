model Room {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  kind      String   @default("classroom")
  capacity  Int?
  createdAt DateTime @default(now())

  timetableEntries TimetableEntry[]

  // Phase 25 — exam operations.
  examSeatingPlans   ExamSeatingPlan[]
  invigilationDuties InvigilationDuty[]

  // Phase T1 — normalized capability catalog (§2), additive on top of the existing `kind` field.
  capabilities RoomCapability[]

  // Phase T4 — a TeachingRequirement may pin to this specific room (roomRequirement=SPECIFIC_ROOM).
  teachingRequirements TeachingRequirement[]

  // Phase T6 — a TimetableSession may pin to this specific room.
  timetableSessions TimetableSession[]

  @@unique([schoolId, name])
  @@index([schoolId])
