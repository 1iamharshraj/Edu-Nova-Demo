  teacherId      String?
  teacher        User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  periodsPerWeek Int      @default(5)
  createdAt      DateTime @default(now())

  timetableEntries    TimetableEntry[]
  assessments         Assessment[]
