model Enrollment {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  rollNo         String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  // Phase 20 — AI-drafted report-card remarks (item 3). No standalone per-(student,term) report-card row
  // exists (report cards are computed on the fly from Assessment/Mark, see modules/assessments/reports.ts),
  // and the ground rules forbid a new Prisma model here beyond GeneratedWorksheet — so the one
  // teacher-editable overall remark per term lives as a JSON map keyed by termId directly on the
  // enrollment it belongs to (Enrollment is already per (studentId, academicYearId), and every Term
  // belongs to exactly one AcademicYear, so `termId` is always a term of this enrollment's year).
  // Shape: { [termId]: { text: string, updatedById: string, updatedAt: string (ISO) } }.
  // Read via modules/assessments/reports.ts#reportCard, written via modules/assessments PUT
  // /report-card/remark (see modules/assessments/service.ts#setReportCardRemark).
  remarks Json @default("{}")

  @@unique([studentId, academicYearId])
  @@index([schoolId])
  @@index([classId])
}

model Guardian {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User     @relation("GuardianParent", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("GuardianStudent", fields: [studentId], references: [id], onDelete: Cascade)
  relation  String   @default("guardian")
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

model AuditLog {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId  String
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([schoolId, at])
}

// ───────────────────────────── Phase 2: timetable ─────────────────────────────

// periods: [{ idx, label, start "HH:MM", end "HH:MM", kind "class" | "break" }]. Exactly one isDefault
// per school (service enforces); Class.periodTemplateId overrides it.
// Phase T1 (roadmap D7) — day-of-week scoping, chosen as the smaller/cleaner extension over a new
// PeriodTemplateDay child table (see phase-t1-timetable-foundations.md §5 and this server agent's report
// for the full reasoning). Two nullable, additive columns:
//   - `dayOfWeek` (1=Mon..6=Sat, null = whole-week/base template — every existing row stays null, so
//     existing behaviour is byte-identical).
//   - `baseTemplateId` — a self-relation. A day-specific OVERRIDE row sets both `dayOfWeek` and
//     `baseTemplateId` (pointing at the base template whose Saturday, say, it replaces). A BASE template
//     (what `Class.periodTemplateId` always points at — never at an override row directly) has both null.
// Effective-periods lookup for (class, day) is: look for an override where baseTemplateId = class's base
// template id AND dayOfWeek = day; else fall back to the base template's own `periods`. See
// modules/periodTemplates/service.ts#resolveForDay.
model PeriodTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  periods   Json
  createdAt DateTime @default(now())

  dayOfWeek      Int?
  baseTemplateId String?
  baseTemplate   PeriodTemplate?  @relation("PeriodTemplateOverrides", fields: [baseTemplateId], references: [id], onDelete: Cascade)
  overrides      PeriodTemplate[] @relation("PeriodTemplateOverrides")

  classes Class[]

  @@index([schoolId])
  @@index([baseTemplateId])
}

// ──────────────────────── Phase T1: advanced-timetable data-model foundations ────────────────────────
// See .agents/edunova/phase-t1-timetable-foundations.md. Purely additive — nothing above this comment in
// the file changed shape/semantics; this phase must be invisible to a school that never touches the new
// config screens.

// §1 (roadmap D2) — layers on top of Class, does not replace it. Every Class gets an implicit 1:1
// `type=SECTION, autoGenerated=true` Cohort (see modules/cohorts/service.ts#ensureSectionCohort, called
// from modules/classes/service.ts#create/update/remove). Schools that need cross-section grouping
// (grade-wide, JEE/NEET, elective baskets) define additional Cohort rows referencing 2+ Class rows via
// CohortClass. Every later phase's TeachingRequirement/TimetableSession references Cohort, never Class.
model Cohort {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  gradeId        String?
  grade          Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  type           String // SECTION | GRADE | CROSS_SECTION | TRACK | ELECTIVE
  autoGenerated  Boolean      @default(false)
  createdAt      DateTime     @default(now())

  members CohortClass[]

  // Phase T3 — student-level membership (needed for TRACK/sub-band cohorts that don't map 1:1 to a Class —
  // see CohortMembership below) and the reverse side of Activity.trackCohortId.
  studentMembers        CohortMembership[]
  trackActivities       Activity[]
  sectioningAssignments SectioningAssignment[]

  // Phase T4 — declared per-subject teaching need (see phase-t4-solver-core.md §1).
  teachingRequirements TeachingRequirement[]

  // Phase T6 — a SharedSession links 2+ cohorts to one TimetableSession (see phase-t6-sessions-jobs.md §1).
  sessionLinks SessionCohort[]

  @@index([schoolId])
  @@index([academicYearId])
}

// Phase T3 §3 — student-level cohort membership. T1's Cohort membership (CohortClass) is class-level,
// which is exactly right for the auto-generated 1:1 SECTION cohort and for GRADE/CROSS_SECTION cohorts —
// but a TRACK cohort (JEE aspirants) or a Stage-2 merit sub-cohort (JEE-A/JEE-B) is a subset of students
// within one or more base classes, not "every student in these classes". This junction is additive and
// only used for that case; SECTION cohorts keep working exactly as before via CohortClass + Enrollment.
model CohortMembership {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("CohortMembershipStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cohortId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

// Join table (this codebase's normalized-junction-table convention, not an array column). A cohort's
// member classes must all share the cohort's own academicYearId — enforced in modules/cohorts/service.ts,
// not at the DB level (Prisma can't express a cross-row-consistency check declaratively here).
model CohortClass {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cohortId, classId])
  @@index([classId])
}

// §2 — normalized capability catalog + junction table (matches this codebase's existing convention, not a
// JSON blob). Room.kind stays exactly as-is; capabilities are additive detail on top.
model Capability {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  createdAt DateTime @default(now())

  rooms RoomCapability[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model RoomCapability {
  id           String     @id @default(cuid())
  roomId       String
  room         Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roomId, capabilityId])
  @@index([capabilityId])
}

// §3 — a declared subject+grade-range+proficiency qualification, for scheduling purposes. Additive
// alongside the existing informal signal (ClassSubject.teacherId implies capability but isn't a declared
// qualification) — that keeps working completely unchanged; this table is what T4/T5's Constraint Builder
// will actually read. gradeRangeMin/Max are grade-level numbers — this schema's numeric grade-level field
// is Grade.order (there is no separate `Grade.level`; the phase spec's "existing Grade.level field"
// reference maps onto `order`, the field that actually orders grades numerically).
model TeacherQualification {
  id               String   @id @default(cuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          User     @relation("TeacherQualificationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeRangeMin    Int
  gradeRangeMax    Int
  proficiency      String // PRIMARY | SECONDARY
  isPrimarySubject Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([teacherId, subjectId, gradeRangeMin, gradeRangeMax])
  @@index([schoolId])
  @@index([teacherId])
  @@index([subjectId])
}

// §5 (roadmap D7) — which weekdays teach at all, including alternating-Saturday patterns. One row per
// (school, academic year). Existing schools have no row until they explicitly configure one — the implicit
// default stays Mon-Fri, ALL working days, saturdayPattern NONE (Phase 26's own build notes: Saturday was
// schema-legal on TimetableEntry.dayOfWeek but unused).
model WorkingDayPattern {
  id              String       @id @default(cuid())
  schoolId        String
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  workingDays     Json // string[], subset of ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]
  saturdayPattern String       @default("NONE") // NONE | ALL | ALTERNATE_1_3 | ALTERNATE_2_4 | HALF_DAY_ALL
  createdAt       DateTime     @default(now())

  @@unique([schoolId, academicYearId])
  @@index([schoolId])
}

model TimetableEntry {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId         String
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 1 = Monday … 6 = Saturday
  periodIdx      Int
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teacherId      String?
  teacher        User?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  substitutions Substitution[]

  // Phase T6 — which TimetableSession (if any) materialized this row. Nullable/additive: every entry
  // written by the manual builder or T4/T5's existing draft-commit path leaves this null, so
  // service.ts#validateGrid's existing teacher/room collision check is completely unchanged for them. When
  // set, it is what lets that SAME conflict engine treat 2+ rows from one SharedSession (same teacher/room/
  // period, different classes, same sessionId) as non-colliding while still catching a genuine double-
  // booking (different/absent sessionId) at that slot — see phase-t6-sessions-jobs.md §1/§2.
  sessionId String?
  session   TimetableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Phase T7 — which TimetableVersion (if any) materialized this row live (see phase-t7-versioning-
  // override.md §1). Nullable/additive: every entry written before this phase, and every entry written by
  // a caller that never touches the version system (most of the app, still), leaves this null — completely
  // unaffected. When set AND that version's status is PUBLISHED, service-layer + Prisma-extension guards
  // (see lib/prismaGuards.ts) refuse any UPDATE/DELETE against the row — §2's enforced immutability.
  timetableVersionId String?
  timetableVersion   TimetableVersion? @relation(fields: [timetableVersionId], references: [id], onDelete: SetNull)

  @@unique([classId, termId, dayOfWeek, periodIdx])
  @@index([schoolId, termId])
  @@index([teacherId])
  @@index([roomId])
  @@index([sessionId])
  @@index([timetableVersionId])
}

model TimetablePublish {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId      String
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  publishedAt DateTime @default(now())

  @@unique([classId, termId])
  @@index([schoolId])
}

model Substitution {
  id                  String         @id @default(cuid())
  schoolId            String
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntryId    String
  timetableEntry      TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  date                DateTime       @db.Date
  substituteTeacherId String
  substituteTeacher   User           @relation(fields: [substituteTeacherId], references: [id], onDelete: Cascade)
  reason              String?
  createdAt           DateTime       @default(now())

  @@unique([timetableEntryId, date])
  @@index([schoolId, date])
  @@index([substituteTeacherId])
}

// ───────────────────── Phase 3: files, attendance, assessment, homework ─────────────────────

// Uploaded file; bytes live at server/uploads/<schoolId>/<id> (gitignored). `path` is that relative path.
model File {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  name       String
  mime       String
  size       Int
  path       String
  sha256     String
  createdAt  DateTime @default(now())

  highlightThumbnails Highlight[]
  employeeDocuments   EmployeeDocument[]
  bookCovers          Book[]
  chapterResources    ChapterResource[]
  submittedDocuments  SubmittedDocument[]

  @@index([schoolId])
}

// periodIdx null = whole-day attendance. Postgres treats NULL as distinct in the unique index, so the
// service enforces one day session per (classId, date) itself.
model AttendanceSession {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId    String
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  periodIdx  Int?
  markedById String?
  markedBy   User?     @relation("SessionMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  lockedAt   DateTime?
  createdAt  DateTime  @default(now())

  records AttendanceRecord[]

  @@unique([classId, date, periodIdx])
  @@index([schoolId, date])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String // P | A | L | E | H
  note      String?

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model StaffAttendance {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("StaffAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  status     String // P | A | L | H
  markedById String?
  markedBy   User?    @relation("StaffAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([userId, date])
  @@index([schoolId, date])
}

// bands: [{ min, grade, points? }] sorted desc by min. boardId null = school-wide fallback scale.
model GradeScale {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  boardId   String?
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: SetNull)
  bands     Json
  createdAt DateTime @default(now())

  @@index([schoolId])
}

model Assessment {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  termId         String
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  name           String
  maxMarks       Float
  weight         Float        @default(1)
  date           DateTime?    @db.Date
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  // Phase 18: chapters this assessment covers, enabling the coverage-vs-learning report. Array column,
  // matching the established convention for this kind of loose id list (see Homework.attachments,
  // Post.mediaFileIds, Activity.forRoles) rather than a join table.
  chapterIds     String[]     @default([])

  marks Mark[]

  // Phase 25 — exam operations.
  examSeats          ExamSeat[]
  invigilationDuties InvigilationDuty[]

  @@index([schoolId])
  @@index([classSubjectId, termId])
}

model Mark {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float
  remark       String?
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model Homework {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  title          String
  description    String       @default("")
  dueDate        DateTime     @db.Date
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  attachments    String[]     @default([]) // File ids
  createdAt      DateTime     @default(now())

  submissions HomeworkSubmission[]

  @@index([schoolId])
  @@index([classSubjectId])
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt DateTime @default(now())
  files       String[] @default([]) // File ids
  note        String?
  status      String   @default("Submitted") // Submitted | Late | Graded | Returned
  grade       String?
  feedback    String?

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

// ───────────────────── Phase 4: admissions, certificates, identity ─────────────────────

// guardian: { name, phone?, email?, relation? }. studentId: the existing student for TC/Bonafide/Character;
// for Admission it is set when the application is approved (the student account that was created).
model Application {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind          String // Admission | TC | Bonafide | Character
  applicantName String
  dob           DateTime? @db.Date
  gender        String?
  guardian      Json?
  targetClassId String?
  targetBoardId String?
  studentId     String?
  student       User?     @relation("ApplicationStudent", fields: [studentId], references: [id], onDelete: SetNull)
  documents     String[]  @default([]) // File ids
  status        String    @default("Pending") // Pending | Verified | Approved | Declined
  notes         String?
  submittedById String?
  submittedBy   User?     @relation("ApplicationSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?     @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  certificates Certificate[]

  // ── Phase T2 Part A — admission data expansion. See phase-t2-strong-admissions.md. All additive/
  // nullable: a school that never touches these fields gets byte-identical existing behavior, and the
  // core approve() atomic student+parent+enrollment+guardian transaction is unchanged — these only add
  // capture-before/handoff-at that point. Only meaningful for kind='Admission' rows, but kept on the same
  // table (matches the existing kind-discriminated Application shape) rather than a satellite 1:1 table,
  // since the field count and lack of any independent lifecycle didn't justify one.
  previousSchoolName      String?
  previousBoardId         String?
  previousBoard           Board?             @relation("ApplicationPreviousBoard", fields: [previousBoardId], references: [id], onDelete: SetNull)
  lastGradeCompleted      String?
  declaredTrackPreference String? // free text for T2; T3's TrackEligibilityRule formalizes this against real Cohort/track data.
  siblingStudentId        String? // set only when no shared-Guardian match was found/accepted — see modules/applications/service.ts#siblingSuggestions.
  siblingStudent          User?              @relation("ApplicationSibling", fields: [siblingStudentId], references: [id], onDelete: SetNull)
  admissionCategoryId     String?
  admissionCategory       AdmissionCategory? @relation(fields: [admissionCategoryId], references: [id], onDelete: SetNull)
  admissionMode           String? // e.g. Regular | RTE | Management | Staff-Ward — drives RequiredDocumentType.requiredIfAdmissionMode.
  healthFlags             Json? // { allergies?, conditions?, bloodGroup? } — small intake subset, NOT a duplicate of HealthRecord; handed off once on approval.
  transportRequired       Boolean            @default(false)
  transportPreferredArea  String?
  transportHandledAt      DateTime? // set once staff have actioned the post-approval transport to-do (assignment made, or explicitly dismissed).

  priorSubjectScores PriorSubjectScore[]
  submittedDocuments SubmittedDocument[]

  @@index([schoolId, status])
  @@index([studentId])
}

// Individual key-subject scores from the applicant's previous school (subject naming is free text since
// it won't match this school's own Subject catalog) — feeds T3's TrackEligibilityRule subject thresholds.
model PriorSubjectScore {
  id            String      @id @default(cuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subjectName   String
  score         Float
  maxScore      Float
  createdAt     DateTime    @default(now())

  @@index([schoolId])
  @@index([applicationId])
}

// School-editable reservation/quota catalog — names vary by state/school-type in India, so this is a
// catalog, not a hardcoded enum. Seeded with a reasonable default set (see modules/admissionDocuments/seed.ts).
model AdmissionCategory {
  id                  String   @id @default(cuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                String
  code                String
  requiresCertificate Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  applications Application[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// School-configurable required-document catalog. Condition model is deliberately simple structured flags
// (no expression parser) — see phase-t2-strong-admissions.md Part B. requiredIfCategoryIn stores
// AdmissionCategory `code`s (not a relation) — matches the spec's plain-flag condition model exactly and
// avoids coupling document-type rows to specific category row ids (a category rename-by-code stays valid).
model RequiredDocumentType {
  id                      String   @id @default(cuid())
  schoolId                String
  school                  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                    String
  code                    String
  requiredIfCategoryIn    String[] @default([]) // AdmissionCategory codes
  requiredIfAdmissionMode String[] @default([]) // e.g. ["RTE"]
  requiredIfBoardChanged  Boolean  @default(false)
  alwaysRequired          Boolean  @default(false)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())

  submittedDocuments SubmittedDocument[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// Links to the existing File model for a digital scan (reused, not duplicated) plus the physical-custody
// fields the user explicitly asked for. applicationId and/or studentId — supports both pre-admission
// (application) and post-enrollment (student) document capture; service layer enforces at least one is set.
model SubmittedDocument {
  id                     String                @id @default(cuid())
  schoolId               String
  school                 School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicationId          String?
  application            Application?          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentId              String?
  student                User?                 @relation("SubmittedDocumentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  requiredDocumentTypeId String?
  requiredDocumentType   RequiredDocumentType? @relation(fields: [requiredDocumentTypeId], references: [id], onDelete: SetNull)
  fileId                 String?
  file                   File?                 @relation(fields: [fileId], references: [id], onDelete: SetNull)
  isOriginal             Boolean               @default(false)
  // Simple structured location — deliberately NOT the same Room entity used for classrooms/labs, since a
  // records room/cabinet/folder isn't a teaching space.
  physicalLocationRoom   String?
  physicalLocationShelf  String?
  physicalLocationFolder String?
  receivedDate           DateTime?             @db.Date
  status                 String                @default("HELD") // HELD | RETURNED | LOST | NOT_APPLICABLE
  returnedDate           DateTime?             @db.Date
  returnedTo             String?
  returnReason           String?
  submittedById          String?
  submittedBy            User?                 @relation("SubmittedDocumentSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())

  @@index([schoolId])
  @@index([applicationId])
  @@index([studentId])
  @@index([status])
}

// Usual 1:1 school-settings row (matches LibrarySettings/AnalyticsSettings/CounselingSettings).
model AdmissionSettings {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  admissionDocumentsBlockApproval Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// serialNo: "EDN/TC/2026/0001" — sequential per school, kind and year (service allocates inside a transaction).
model Certificate {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind          String // TC | Bonafide | Character
  studentId     String
  student       User         @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  serialNo      String
  issuedById    String?
  issuedBy      User?        @relation("CertificateIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt      DateTime     @default(now())
  pdfFileId     String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([schoolId, serialNo])
  @@index([studentId])
}

model BoardRegistration {
  id                String    @id @default(cuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           User      @relation("BoardRegStudent", fields: [studentId], references: [id], onDelete: Cascade)
  boardId           String
  academicYearId    String
  registrationNo    String?
  rollNo            String?
  nameOnCertificate String
  dob               DateTime? @db.Date
  affiliationNo     String?
  status            String    @default("Draft") // Draft | Pending | Validated | SentToBoard
  validatedById     String?
  validatedBy       User?     @relation("BoardRegValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt       DateTime?
  sentAt            DateTime?
  mismatchNote      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([studentId, academicYearId])
  @@index([schoolId, status])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One record per parent; User.verified mirrors `status === "Verified"` (service keeps it in sync).
model ParentVerification {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId       String    @unique
  parent         User      @relation("VerificationParent", fields: [parentId], references: [id], onDelete: Cascade)
  method         String // Document | InPerson | Aadhaar
  status         String    @default("Pending") // Pending | Verified | Rejected
  documentFileId String?
  verifiedById   String?
  verifiedBy     User?     @relation("VerificationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt     DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([schoolId, status])
}

// ───────────────────────── Phase 5: finance (fees, payments, payroll) ─────────────────────────

model FeeHead {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([schoolId, name])
  @@index([schoolId])
}

// lines: [{ feeHeadId, amount }]
model FeeStructure {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  dueDate   DateTime @db.Date
  lines     Json
  createdAt DateTime @default(now())

  invoices         FeeInvoice[]
  installmentPlans FeeInstallmentPlan[]

  @@unique([classId, termId])
  @@index([schoolId])
}

// Phase 21 item 5 — parent-facing fee installment plans. `installments`: JSON array of
// { label, percentage?, amount?, dueDateOffsetDays } (exactly one of percentage/amount per entry,
// validated in schema.ts; percentages across all entries must sum to 100 when percentage-based).
// dueDateOffsetDays is added to the parent FeeStructure.dueDate to get each installment's due date.
model FeeInstallmentPlan {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  name           String
  installments   Json
  createdAt      DateTime     @default(now())

  invoices FeeInvoice[]

  @@unique([feeStructureId, name])
  @@index([schoolId])
}

// lines: [{ feeHeadId, name, amount }]. invoiceNo: "INV/2026/0001" — sequential per school + year.
// unique(studentId, feeStructureId, installmentLabel): Postgres treats NULL as distinct (ad-hoc invoices,
// feeStructureId null, never collide), and installmentLabel defaults to "" (not null) so a structure's
// single lump-sum invoice per student still behaves exactly as before Phase 21 (one row per
// student+structure); a Phase 21 installment plan's invoices for the same student+structure instead get
// one distinct non-empty label each ("Q1", "Q2", ...), so generate-invoices stays idempotent per
// student+structure+installment the same way it was already idempotent per student+structure.
model FeeInvoice {
  id                String              @id @default(cuid())
  schoolId          String
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           User                @relation("FeeInvoiceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId    String?
  feeStructure      FeeStructure?       @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  installmentPlanId String?
  installmentPlan   FeeInstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  installmentLabel  String              @default("")
  termId            String
  term              Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  lines             Json
  total             Float
  concession        Float               @default(0)
  dueDate           DateTime            @db.Date
  status            String              @default("Due") // Due | PartiallyPaid | Paid | Waived
  invoiceNo         String
  createdAt         DateTime            @default(now())

  payments  Payment[]
  reminders FeeReminder[]

  @@unique([studentId, feeStructureId, installmentLabel])
  @@unique([schoolId, invoiceNo])
  @@index([schoolId])
  @@index([termId])
  @@index([studentId])
  @@index([installmentPlanId])
}

// receiptNo: "RCPT/2026/0001" — sequential per school + year.
model Payment {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Float
  method       String // UPI | Card | NetBanking | Cash | Cheque
  reference    String?
  paidAt       DateTime   @default(now())
  recordedById String?
  recordedBy   User?      @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  receiptNo    String
  note         String?

  @@unique([schoolId, receiptNo])
  @@index([invoiceId])
  @@index([schoolId])
}

model FeeReminder {
  id        String     @id @default(cuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentById  String?
  sentBy    User?      @relation("FeeReminderSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  channel   String // InApp | Email | SMS
  sentAt    DateTime   @default(now())
  note      String?

  @@index([invoiceId])
  @@index([schoolId])
}

// allowances/deductions: [{ name, amount }]
model SalaryStructure {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId        String   @unique
  user          User     @relation("SalaryStructureUser", fields: [userId], references: [id], onDelete: Cascade)
  basic         Float
  allowances    Json
  deductions    Json
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())

  @@index([schoolId])
}

// month: "2026-06". slipNo: "PAY/2026/0001" — sequential per school + year.
model Payslip {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("PayslipUser", fields: [userId], references: [id], onDelete: Cascade)
  month      String
  basic      Float
  allowances Json
  deductions Json
  gross      Float
  net        Float
  status     String    @default("Generated") // Generated | Paid
  paidAt     DateTime?
  paidById   String?
  paidBy     User?     @relation("PayslipPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  slipNo     String
  createdAt  DateTime  @default(now())

  @@unique([userId, month])
  @@unique([schoolId, slipNo])
  @@index([schoolId])
}

// ───────────────────────── Phase 6 HR (leave, contracts, resignations, duties) ─────────────────────────

// appliesTo: student | staff. daysPerYear 0 means unlimited (e.g. student leave).
model LeaveType {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  daysPerYear Int
  appliesTo   String
  createdAt   DateTime @default(now())

  requests LeaveRequest[]

  @@unique([schoolId, name, appliesTo])
  @@index([schoolId])
}

// days: computed on create, excluding Sundays in [fromDate, toDate].
model LeaveRequest {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requesterId  String
  requester    User       @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  forUserId    String
  forUser      User       @relation("LeaveForUser", fields: [forUserId], references: [id], onDelete: Cascade)
  leaveTypeId  String?
  leaveType    LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  fromDate     DateTime   @db.Date
  toDate       DateTime   @db.Date
  days         Int
  reason       String
  status       String     @default("Pending") // Pending | Approved | Declined | Cancelled
  decidedById  String?
  decidedBy    User?      @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime   @default(now())

  // Phase T9 §3 — the substitution workflow attaches here rather than forking a parallel leave model. When
  // one or more SubstitutionRequest rows are in flight for this leave request (SENT, not yet accepted/
  // declined/expired), `status` is temporarily set to "PENDING_SUBSTITUTION" — the one new lifecycle value
  // this phase adds, sitting strictly before the existing "Pending" (which is what leave/service.ts's
  // approve()/decline() still gate on, unchanged) — and flips back to "Pending" once every outstanding
  // request for it resolves (accepted, declined-with-no-further-attempt, or expired), so a leave that never
  // touches a teaching period never sees this status at all. See substitution.ts.
  substitutionRequests SubstitutionRequest[]

  @@index([schoolId])
  @@index([forUserId])
}

model Contract {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation("ContractUser", fields: [userId], references: [id], onDelete: Cascade)
  designation      String
  department       String?
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  terms            String
  status           String    @default("Draft") // Draft | Active | Ended
  employeeSignedAt DateTime?
  adminSignedAt    DateTime?
  adminSignedById  String?
  adminSignedBy    User?     @relation("ContractAdminSignedBy", fields: [adminSignedById], references: [id], onDelete: SetNull)
  endedAt          DateTime?
  endReason        String?
  pdfFileId        String?
  createdAt        DateTime  @default(now())

  @@index([schoolId])
  @@index([userId])
}

model Resignation {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation("ResignationUser", fields: [userId], references: [id], onDelete: Cascade)
  reason          String
  submittedAt     DateTime  @default(now())
  lastWorkingDate DateTime  @db.Date
  status          String    @default("Pending") // Pending | Approved | Declined | Withdrawn
  decidedById     String?
  decidedBy       User?     @relation("ResignationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  notes           String?

  @@index([schoolId])
  @@index([userId])
}

model Duty {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  eventTitle  String
  eventDate   DateTime @db.Date
  assigneeId  String?
  assignee    User?    @relation("DutyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation("DutyCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  status      String   @default("Assigned") // Assigned | Done
  notes       String?
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([assigneeId])
}

// ───────────────────────── Phase 7 Communication (feed, messages, notifications, meetings, calendar) ─────────────────────────

// audience: School | Class | Role. classId set when audience=Class, role set when audience=Role.
model Post {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  audience     String
  classId      String?
  class        Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  role         String?
  title        String?
  body         String
  mediaFileIds String[] @default([])
  pinned       Boolean  @default(false)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  reactions PostReaction[]
  comments  PostComment[]

  @@index([schoolId])
  @@index([classId])
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

// kind: DM | Group. classId set for a class group conversation.
model Conversation {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind        String
  title       String?
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  participants Participant[]
  messages     Message[]

  @@index([schoolId])
  @@index([classId])
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  fileIds        String[]     @default([])
  sentAt         DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model Notification {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId])
  @@index([userId])
}

// status: Requested | Scheduled | Completed | Cancelled | Declined. link generated on Scheduled (Jitsi).
model Meeting {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User      @relation("MeetingRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  withUserId  String
  withUser    User      @relation("MeetingWithUser", fields: [withUserId], references: [id], onDelete: Cascade)
  studentId   String?
  student     User?     @relation("MeetingStudent", fields: [studentId], references: [id], onDelete: SetNull)
  purpose     String
  scheduledAt DateTime
  durationMin Int       @default(30)
  link        String?
  status      String    @default("Requested")
  decidedById String?
  decidedBy   User?     @relation("MeetingDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([schoolId])
  @@index([requesterId])
  @@index([withUserId])
}

// type: holiday | exam | event. audience: School | Class.
model CalendarEvent {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime  @db.Date
  endDate     DateTime? @db.Date
  type        String
  audience    String
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId      String?
  term        Term?     @relation(fields: [termId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User      @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([schoolId])
  @@index([classId])
}

// ── Phase 8 — welfare & compliance. See phase-8-welfare.md. ──

// kind: Vaccination|Allergy|Condition|Checkup|Other. Visible only to the student, guardians, class
// teacher, staff/admin (enforced in service, not schema).
model HealthRecord {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation("HealthRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  detail       String
  date         DateTime  @db.Date
  addedById    String
  addedBy      User      @relation("HealthRecordAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  verifiedById String?
  verifiedBy   User?     @relation("HealthRecordVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  fileIds      String[]  @default([])
  createdAt    DateTime  @default(now())

  @@index([schoolId])
  @@index([studentId])
}

// classId null = all classes. requiresVerifiedParent gates SlipResponse on the parent's `verified` flag.
model PermissionSlip {
  id                     String   @id @default(cuid())
  schoolId               String
  school                 School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title                  String
  detail                 String
  dueDate                DateTime @db.Date
  classId                String?
  class                  Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById            String
  createdBy              User     @relation("SlipCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  requiresVerifiedParent Boolean  @default(true)
  createdAt              DateTime @default(now())

  responses SlipResponse[]

  @@index([schoolId])
  @@index([classId])
}

// decision: Approved|Declined.
model SlipResponse {
  id          String         @id @default(cuid())
  slipId      String
  slip        PermissionSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  studentId   String
  student     User           @relation("SlipResponseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  parentId    String
  parent      User           @relation("SlipResponseParent", fields: [parentId], references: [id], onDelete: Cascade)
  decision    String
  respondedAt DateTime       @default(now())
  note        String?

  @@unique([slipId, studentId])
  @@index([slipId])
}

// category: Academic|Sports|Arts|Service|Other.
model Achievement {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("AchievementUser", fields: [userId], references: [id], onDelete: Cascade)
  title        String
  detail       String
  date         DateTime  @db.Date
  category     String
  verifiedById String?
  verifiedBy   User?     @relation("AchievementVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  fileIds      String[]  @default([])
  createdAt    DateTime  @default(now())

  @@index([schoolId])
  @@index([userId])
}

// status: Reported|Scheduled|Heard|Decision|Action Taken|Appealed|Closed. Soft delete via deletedAt
// (admin only) — excluded from default lists but kept for audit.
model DisciplinaryCase {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String
  student       User      @relation("DisciplinaryCaseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  classId       String?
  class         Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  title         String
  description   String
  reportedById  String
  reportedBy    User      @relation("DisciplinaryCaseReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  witnesses     String?
  fileIds       String[]  @default([])
  status        String    @default("Reported")
  hearingDate   DateTime?
  decision      String?
  actionTaken   String?
  appeal        String?
  relatedPeople String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  notes DisciplinaryNote[]

  @@index([schoolId])
  @@index([studentId])
}

// Status-change log + free-form notes on a disciplinary case.
model DisciplinaryNote {
  id        String           @id @default(cuid())
  caseId    String
  case      DisciplinaryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation("DisciplinaryNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime         @default(now())

  @@index([caseId])
}

// reason: fee|attendance|disciplinary|general. outcome: confirmed|callback|unreachable|refused|other.
// Replaces the AI call simulation — a real call staff/teacher/admin made and logged.
model CallLog {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("CallLogStudent", fields: [studentId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      User?    @relation("CallLogParent", fields: [parentId], references: [id], onDelete: SetNull)
  byId        String
  by          User     @relation("CallLogBy", fields: [byId], references: [id], onDelete: Cascade)
  reason      String
  summary     String
  outcome     String
  calledAt    DateTime @default(now())
  durationMin Int?

  @@index([schoolId])
  @@index([studentId])
}

// kind: club|house|exc|event|faculty. forRoles gates who may register; capacity → waitlist.
model Activity {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  description String
  capacity    Int?
  opensAt     DateTime?
  closesAt    DateTime?
  forRoles    String[]  @default([])
  createdById String
  createdBy   User      @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  registrations ActivityRegistration[]
  housePoints   HousePoints[]          @relation("HousePointsHouse")

  // Phase T3 — sectioning engine, §3 (Track/Stream two-stage pipeline). Only set when this Activity is
  // used as a track's choice-collection surface (typically kind='track'): links it to the T1 `Cohort`
  // (type=TRACK) that actual membership is written into once a registration is confirmed. Nullable/
  // additive — every existing Activity (club/house/exc/event/faculty) is completely unaffected.
  trackCohortId    String?
  trackCohort      Cohort?                @relation(fields: [trackCohortId], references: [id], onDelete: SetNull)
  eligibilityRules TrackEligibilityRule[]

  @@index([schoolId])
}

// status: Registered|Waitlisted|Cancelled.
model ActivityRegistration {
  id           String   @id @default(cuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("ActivityRegistrationUser", fields: [userId], references: [id], onDelete: Cascade)
  registeredAt DateTime @default(now())
  status       String   @default("Registered")

  @@unique([activityId, userId])
  @@index([activityId])
}

// ───────────────────────── Phase 27 — culture & engagement ─────────────────────────
// See phase-27-culture-engagement.md item 1. Additive points ledger for the inter-house leaderboard — a
// "house" is an Activity row with kind='house' (see ACTIVITY_KINDS); which house a student belongs to is
// resolved via their Registered ActivityRegistration for that Activity, not a redundant field here. Points
// are never mutated/replaced — the leaderboard is always a SUM(points) GROUP BY houseActivityId query, so
// concurrent awards never race each other (same reasoning as the GL/library-fine ledgers elsewhere).
model HousePoints {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  houseActivityId String
  houseActivity   Activity @relation("HousePointsHouse", fields: [houseActivityId], references: [id], onDelete: Cascade)
  points          Int
  reason          String
  awardedById     String
  awardedBy       User     @relation("HousePointsAwardedBy", fields: [awardedById], references: [id], onDelete: Cascade)
  awardedAt       DateTime @default(now())
  sourceType      String? // Sports | Academic | Discipline | Event | Manual
  sourceRefId     String?

  @@index([schoolId])
  @@index([houseActivityId])
}

// ── Phase 9 — integrations & AI. See phase-9-10-integrations-hardening.md. ──

// One conversation thread per student (optionally scoped to a subject). Messages are the exchange with the
// Claude API; role is "user" | "assistant". Rate-limited to 30 user messages/day/student (see modules/ai).
model AiConversation {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("AiConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title     String?
  createdAt DateTime @default(now())

  messages AiMessage[]

  @@index([schoolId])
  @@index([studentId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// Event highlights CMS. url = YouTube/Drive link; audience mirrors CalendarEvent (School | Class).
model Highlight {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title           String
  url             String
  thumbnailFileId String?
  thumbnailFile   File?    @relation(fields: [thumbnailFileId], references: [id], onDelete: SetNull)
  audience        String
  classId         String?
  class           Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  publishedAt     DateTime @default(now())
  createdById     String
  createdBy       User     @relation("HighlightCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([schoolId])
  @@index([classId])
}

// Web Push subscriptions (PWA). One row per browser/device subscription for a user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("PushSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────────── Phase 10: hardening ─────────────────────────────

// Refresh-token sessions for JWT refresh (see phase-9-10-integrations-hardening.md → Phase 10 §2).
// Access tokens are short-lived (15 min); a Session row backs a longer-lived, rotating refresh token.
// Only a sha256 hash of the raw refresh token is ever stored.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Telephony (real outbound/inbound calling) is explicitly out of scope for Phase 9 — the Call log
// (Phase 8, modules/calls) is the shipped replacement for the old AI-call simulation. If real telephony
// is ever added, it would live here as a `modules/telephony` wrapper around a provider (Twilio/Exotel)
// following this same module pattern.

// ───────────────────────────── Phase 11: employee management ─────────────────────────────
// See phase-11-employee-management.md. Builds on `hr`/`payroll`/`users` — contracts, resignations,
// duties, leave, staff attendance and salary structures are untouched. Adds: employee IDs (A1, on
// User.employeeId above), a real reportsTo relation (A2, on User.manager/reports above), performance
// reviews (A3), employment history logging (A4), staff conduct records (A5), and labeled employee
// documents + ID card PDF (A6).

// A3 — performance review. Workflow: Draft (reviewer/HR editing) -> Shared (employee can see + comment)
// -> Acknowledged (locked). `overallRating` is 1-5 (documented in modules/reviews/schema.ts).
model PerformanceReview {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  employeeId String
  employee   User   @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User   @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  cycle       String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  overallRating       Int
  strengths           String
  areasForImprovement String
  goals               String
  employeeComments    String?

  status         String    @default("Draft")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sharedAt       DateTime?
  acknowledgedAt DateTime?

  @@index([schoolId])
  @@index([employeeId])
  @@index([reviewerId])
}

// A4 — append-only employment-history log (role/designation/department/salary changes). Written by a
// best-effort hook called from routes/users.ts (`PATCH /:id/role`, `PATCH|PUT /:id`) and
// modules/payroll/service.ts (`upsertStructure`) — see modules/employmentHistory/service.ts#logChange.
model EmploymentHistoryEntry {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("EmploymentHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  changeType    String
  fromValue     String?
  toValue       String
  effectiveDate DateTime @db.Date

  changedById String
  changedBy   User    @relation("EmploymentHistoryChangedBy", fields: [changedById], references: [id], onDelete: Cascade)
  note        String?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
}

// A5 — staff disciplinary/conduct records. Deliberately NOT the student `DisciplinaryCase` model
// (different visibility/actors — see phase-11-employee-management.md A5). Strictly HR/admin/superadmin:
// not visible to the employee's manager or to the employee themselves.
model StaffConductRecord {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  employeeId String
  employee   User   @relation("ConductEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  reportedById String
  reportedBy   User   @relation("ConductReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)

  title       String
  description String
  category    String
  status      String   @default("Reported")
  actionTaken String?
  fileIds     String[] @default([])

  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ConductResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([employeeId])
}

// A6 — labeled employee documents (ID proof, degree certificate, ...), a thin join over the existing
// `files` module. No new file-storage code: upload via POST /api/files first, then attach the returned
// fileId here with a label.
model EmployeeDocument {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("EmployeeDocumentUser", fields: [userId], references: [id], onDelete: Cascade)

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  label String

  uploadedById String
  uploadedBy   User     @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedAt   DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
}

// ───────────────────────── Phase 12: transport / bus management ─────────────────────────
// See phase-12-transport.md. Driver/conductor are plain contact fields on Vehicle, NOT `User` accounts —
// a future Kotlin Multiplatform app owns driver auth + GPS reporting; this phase only builds the data
// model, admin setup endpoints, and the read/ping endpoints that app will eventually call.

model Route {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  stops    Stop[]
  vehicles Vehicle[]

  @@index([schoolId])
}

model Stop {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routeId  String
  route    Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  name             String
  sequence         Int
  latitude         Float?
  longitude        Float?
  arrivalOffsetMin Int?

  assignments StudentStopAssignment[]

  @@unique([routeId, sequence])
  @@index([schoolId])
  @@index([routeId])
}

model Vehicle {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  registrationNo String
  capacity       Int
  routeId        String?
  route          Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)

  driverName     String
  driverPhone    String
  conductorName  String?
  conductorPhone String?

  // Optional link to an existing staff/teacher/admin `User` — NOT required, NOT a new auth flow. Useful
  // if a driver happens to also be a staff account today; the future native app's own driver-auth story
  // is unrelated and out of scope here.
  driverUserId String?
  driverUser   User?   @relation("VehicleDriverUser", fields: [driverUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  locations VehicleLocation[]

  @@unique([schoolId, registrationNo])
  @@index([schoolId])
  @@index([routeId])
}

model StudentStopAssignment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StopAssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  stopId    String
  stop      Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)

  // Pickup | Drop | Both — validated in schema.ts, not a DB enum (matches the rest of the codebase's
  // convention of plain-string "enums" validated by zod, e.g. StaffConductRecord.category).
  boardingType String   @default("Both")
  createdAt    DateTime @default(now())

  // A student may have at most one assignment per boarding type (e.g. a distinct Pickup stop and Drop
  // stop, or a single "Both" row covering both legs).
  @@unique([studentId, boardingType])
  @@index([schoolId])
  @@index([stopId])
}

// The live-location log. History is kept (never overwritten) since it's cheap and useful later (e.g. an
// "was the bus on time" report); "current location" reads just take the latest row per vehicle, made
// efficient by the (vehicleId, recordedAt) index below.
model VehicleLocation {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())
  tripDate   DateTime @db.Date

  @@index([vehicleId, recordedAt])
  @@index([schoolId])
}

// ───────────────────────────── Phase 13: alumni management ─────────────────────────────
// See phase-13-alumni.md. Tracks former students after they leave school (via TC or graduation), plus
// alumni events/RSVPs and manually-recorded donations. Alumni are deliberately NOT `User`s — no alumni
// portal/login in this system (out of scope) — so `studentUserId` is just an optional link back to the
// original student account, and RSVPs/donations are always entered BY staff on an alumnus's behalf.
//
// Conversion design decision (POST /alumni/convert-student, modules/alumni/service.ts#convertStudent):
// the student's `User` row is left untouched (role stays 'student', `active` stays true) — same as how
// TC issuance (applications/service.ts `approve()`) already treats the account: it ends the active
// `Enrollment` (status -> 'transferred') but never flips role/active. Alumni conversion mirrors that:
// it ends any active enrollment too, but with status 'graduated' (the pre-existing but previously-unused
// third `Enrollment.status` value from modules/enrollments/schema.ts) when the conversion is NOT
// following a TC — i.e. a direct/standalone "this student is now an alumnus" action, not a transfer-out.
// When conversion is triggered from the TC-approval flow itself (see applications/service.ts `approve()`
// `convertToAlumni` option), the enrollment is already 'transferred' by that flow and is left as-is.
// Deactivating the User account was considered (mirroring HR's Resignation -> `active: false`) but
// rejected: TC issuance — the closest and most frequent precedent for "a student is leaving" — never
// deactivates the account, only ends the enrollment, and a school may reasonably want a former student's
// historical login (report cards, messages, certificates) to keep working read-only rather than lock out
// on conversion. This can be revisited as an explicit opt-in later without a schema change.
model AlumniProfile {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Optional link back to the original student User row (see note above) — null for alumni who were
  // never in this system as a student (a purely historical/manual record).
  studentUserId String?
  studentUser   User?   @relation("AlumniProfileStudent", fields: [studentUserId], references: [id], onDelete: SetNull)

  name                String
  email               String?
  phone               String?
  graduationYear      Int
  // Denormalized at conversion time (e.g. "X-B CBSE") since the Class itself may later change or be
  // deleted — never a live FK.
  lastClassLabel      String?
  currentOccupation   String?
  currentOrganization String?
  currentCity         String?
  linkedInUrl         String?
  notes               String?

  convertedAt   DateTime @default(now())
  convertedById String?
  convertedBy   User?    @relation("AlumniProfileConvertedBy", fields: [convertedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsvps     AlumniEventRsvp[]
  donations AlumniDonation[]

  @@index([schoolId])
  @@index([studentUserId])
  @@index([graduationYear])
}

model AlumniEvent {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title       String
  description String?
  date        DateTime @db.Date
  location    String?

  createdById String?
  createdBy   User?   @relation("AlumniEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsvps AlumniEventRsvp[]

  @@index([schoolId])
}

// One RSVP per alumnus per event (unique below) — recording again just updates status/respondedAt.
// No `recordedById`: who performed the write is already in AuditLog (action 'create'/'update' on entity
// 'alumniEventRsvp'), and the spec's field list for this model is deliberately minimal.
model AlumniEventRsvp {
  id      String      @id @default(cuid())
  eventId String
  event   AlumniEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  alumniId String
  alumni   AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  status      String   @default("Interested") // Interested | Going | Declined
  respondedAt DateTime @default(now())

  @@unique([eventId, alumniId])
  @@index([eventId])
  @@index([alumniId])
}

// Manual record-keeping only (a cheque / bank transfer / cash donation logged after the fact) — NOT a
// payment gateway integration; see phase-13-alumni.md.
model AlumniDonation {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  alumniId String
  alumni   AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  amount    Float
  purpose   String?
  donatedAt DateTime @default(now())
  note      String?

  recordedById String?
  recordedBy   User?   @relation("AlumniDonationRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([alumniId])
}

// ───────────────────────────── Phase 14: hostel management ─────────────────────────────
// See phase-14-hostel.md. `HostelBed` is one row per physical bed (not just a capacity counter on the
// room) so occupancy is exact; `HostelRoom.capacity` is kept in sync with its bed count by the service
// layer (auto-creating `capacity` beds — labelled 1..N — when a room is created; adding/removing a bed
// later adjusts `capacity` to match, see modules/hostel/service.ts).
//
// Visitor log and mess/meal-plan are explicitly out of scope for this pass per the spec (skippable
// nice-to-haves) — not built here.
model Hostel {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String
  type String // Boys | Girls | Mixed

  // Optional link to an existing staff/teacher/admin User (not a new "warden" role/account) — mirrors
  // Vehicle.driverUserId (Phase 12) and Hostel.wardenUserId in the spec.
  wardenUserId String?
  warden       User?   @relation("HostelWarden", fields: [wardenUserId], references: [id], onDelete: SetNull)

  address String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms HostelRoom[]

  // Phase 24 additions.
  outpasses HostelOutpass[]
  rollCalls HostelRollCall[]
  messMenus MessMenu[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([wardenUserId])
}

model HostelRoom {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  hostelId String
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  roomNumber String
  floor      String?
  capacity   Int // kept equal to the count of HostelBed rows for this room — see service.ts
  roomType   String? // e.g. "Dorm" | "Double" | "Single"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beds HostelBed[]

  @@unique([hostelId, roomNumber])
  @@index([schoolId])
  @@index([hostelId])
}

model HostelBed {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  roomId String
  room   HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  bedLabel String // e.g. "A" / "B" or "1" / "2" / "3"

  createdAt DateTime @default(now())

  allocations HostelAllocation[]

  @@unique([roomId, bedLabel])
  @@index([schoolId])
  @@index([roomId])
}

// A student may have at most one `Active` allocation at a time, and a bed may have at most one `Active`
// allocation at a time — enforced primarily in modules/hostel/service.ts (clear 4xx errors, not a 500),
// and backstopped at the database level by two partial unique indexes added by hand in this model's
// migration (`WHERE status = 'Active'`) so a race between two concurrent requests still can't double-book
// a bed or double-allocate a student — Prisma's schema DSL can't express a partial unique index, so it is
// not declared as `@@unique` here (see migration.sql).
//
// Transfer (vacate old bed + allocate new bed) is done as vacate-then-create in one `prisma.$transaction`
// (service.ts#transferAllocation) — the old row is marked `Transferred` (not `Vacated`, so its history
// reads distinctly from a plain checkout) and a fresh `Active` row is created on the new bed, rather than
// mutating `bedId` on the existing row, to keep the occupancy history honest.
model HostelAllocation {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("HostelAllocationStudent", fields: [studentId], references: [id], onDelete: Cascade)

  bedId String
  bed   HostelBed @relation(fields: [bedId], references: [id], onDelete: Cascade)

  checkInDate  DateTime  @db.Date
  checkOutDate DateTime? @db.Date // null while active
  status       String    @default("Active") // Active | Vacated | Transferred

  allocatedById String?
  allocatedBy   User?   @relation("HostelAllocationAllocatedBy", fields: [allocatedById], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 24 addition.
  rollCallEntries HostelRollCallEntry[]

  @@index([schoolId])
  @@index([studentId])
  @@index([bedId])
  @@index([status])
}

// ───────────────────────────── Phase 24: hostel outpass / leave workflow ─────────────────────────────
// See phase-24-boarding-hostel-extensions.md → item 1. Student or parent requests leave from the hostel;
// the hostel's warden (identified via the student's active HostelAllocation → HostelBed → HostelRoom →
// Hostel.wardenUserId) approves/declines; gate/warden logs actual depart/return. `Overdue` is not a
// stored status the row transitions into — it's computed at read time in service.ts (Departed, past
// expectedReturnAt, no actualReturnAt) per the spec ("computed-at-read is simpler ... don't build a
// scheduler for this").
model HostelOutpass {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("HostelOutpassStudent", fields: [studentId], references: [id], onDelete: Cascade)

  // Denormalized snapshot of the student's hostel at request time (via their active HostelAllocation),
  // same convention as HostelBed/HostelRoom keeping schoolId alongside their real parent FK — lets the
  // warden's "my hostel" scoping query directly instead of joining through allocation history, and keeps
  // old requests attributed to the right hostel even if the student is later reallocated/vacated.
  hostelId String
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  // Who submitted the request — the student themself, or a parent on the student's behalf.
  requestedById String
  requestedBy   User   @relation("HostelOutpassRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  requestedDepartureAt DateTime
  expectedReturnAt     DateTime
  reason               String
  destination          String?

  status String @default("Pending") // Pending | Approved | Declined | Departed | Returned

  approvedByWardenId String?
  approvedByWarden   User?     @relation("HostelOutpassApprovedBy", fields: [approvedByWardenId], references: [id], onDelete: SetNull)
  approvedAt         DateTime?

  actualDepartureAt DateTime?
  actualReturnAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([hostelId])
  @@index([status])
}

// ───────────────────────────── Phase 24: night roll-call ─────────────────────────────
// Mirrors AttendanceSession/AttendanceRecord (Phase 3) exactly: one session per (hostel, date), entries
// pre-populated for every currently-Active allocation in that hostel — "create session, then patch
// records" (POST creates + pre-populates, PATCH bulk-updates presence).
model HostelRollCall {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  hostelId String
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  recordedById String?
  recordedBy   User?   @relation("HostelRollCallRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  entries HostelRollCallEntry[]

  @@unique([hostelId, date])
  @@index([schoolId])
}

model HostelRollCallEntry {
  id String @id @default(cuid())

  rollCallId String
  rollCall   HostelRollCall @relation(fields: [rollCallId], references: [id], onDelete: Cascade)

  allocationId String
  allocation   HostelAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  present Boolean @default(true)
  notes   String?

  @@unique([rollCallId, allocationId])
  @@index([allocationId])
}

// ───────────────────────────── Phase 24: mess menu + meal feedback ─────────────────────────────
model MessMenu {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  hostelId String
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  date     DateTime @db.Date
  mealType String // Breakfast | Lunch | Snacks | Dinner
  items    String[] @default([])

  createdById String?
  createdBy   User?   @relation("MessMenuCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback MealFeedback[]

  @@unique([hostelId, date, mealType])
  @@index([schoolId])
}

model MealFeedback {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  menuId String
  menu   MessMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("MealFeedbackStudent", fields: [studentId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@unique([menuId, studentId])
  @@index([schoolId])
  @@index([menuId])
}

// ───────────────────────────── Phase 15: library management ─────────────────────────────
// See phase-15-library.md. `Book` is the catalog entry (one row per title); `BookCopy` is one row per
// physical copy, since a library holds several copies of the same title. `BookCopy.schoolId` and
// `Loan.schoolId` are denormalized (not derivable only via a join through Book) purely for scoping/
// uniqueness queries without an extra join, matching the rest of the codebase's convention (e.g.
// StudentStopAssignment, HostelRoom keep a schoolId alongside their real parent FK).
model Book {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title     String
  author    String
  isbn      String?
  publisher String?
  category  String?

  // Optional cover image — reuses the existing files module rather than a new upload path.
  coverFileId String?
  coverFile   File?   @relation(fields: [coverFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  copies BookCopy[]

  @@index([schoolId])
  @@index([schoolId, category])
}

model BookCopy {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  barcode    String
  condition  String? // New | Good | Worn | Damaged
  status     String    @default("Available") // Available | Loaned | Lost | Retired
  acquiredAt DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans Loan[]

  @@unique([schoolId, barcode])
  @@index([schoolId])
  @@index([bookId])
  @@index([schoolId, status])
}

// One row per issue-and-return cycle. `dueDate` is computed at issue time from `LibrarySettings.
// loanPeriodDays` and frozen on the row (a later settings change never retroactively moves an
// already-issued loan's due date). `fineAmount`/`fineStatus` are populated at return time only if
// overdue — see modules/library/service.ts#returnLoan.
model Loan {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  copyId String
  copy   BookCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)

  borrowerId String
  borrower   User   @relation("LoanBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)

  issuedAt   DateTime  @default(now())
  dueDate    DateTime  @db.Date
  returnedAt DateTime?

  fineAmount Float?
  fineStatus String @default("None") // None | Pending | Paid | Waived

  issuedById String
  issuedBy   User   @relation("LoanIssuedBy", fields: [issuedById], references: [id], onDelete: Cascade)

  returnedById String?
  returnedBy   User?   @relation("LoanReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([copyId])
  @@index([borrowerId])
  @@index([schoolId, returnedAt])
}

// One row per school — editable by admin so the numbers aren't hardcoded. Created lazily (with defaults)
// the first time it's read or written, mirroring how other singleton-per-school settings are handled
// elsewhere in this codebase (no separate seed step required before the endpoint works).
model LibrarySettings {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  loanPeriodDays        Int   @default(14)
  maxActiveLoansStudent Int   @default(3)
  maxActiveLoansStaff   Int   @default(5)
  finePerDayOverdue     Float @default(2)

  updatedAt DateTime @updatedAt
}

// ───────────────────────── Phase 16 — inventory / procurement ─────────────────────────
// See phase-16-inventory.md. Core invariant: `currentStock` is denormalized and must ONLY ever change
// via a `StockMovement` write — modules/inventory/service.ts#recordMovement is the single place that
// touches this column; the item update schema rejects `currentStock` outright (see schema.ts).

model InventoryItem {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name             String
  category         String? // e.g. "Lab Equipment", "Sports", "Furniture", "Stationery", "IT"
  unit             String // e.g. "pcs", "box", "kg"
  isConsumable     Boolean @default(true) // consumables get used up and restocked; fixed assets (a projector) don't
  reorderThreshold Int? // low-stock warning threshold — only meaningful for consumables
  currentStock     Int     @default(0) // denormalized; ONLY written by recordMovement — never directly

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
  poLines   PurchaseOrderLine[]

  @@index([schoolId])
  @@index([schoolId, category])
}

model StockMovement {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  type     String // In | Out | Adjustment
  quantity Int // In/Out: always positive, direction implied by `type`. Adjustment: signed (a correction
  // can go either way — a recount finding more stock than expected, damage/loss finding less), since
  // there is no third value to hang "direction" off of the way there is for In vs Out.
  reason   String? // e.g. "Purchase", "Issued to Science Lab", "Damaged", "Annual count correction"

  relatedPoId String? // nullable link to the PurchaseOrder this movement came from receiving, if any
  relatedPo   PurchaseOrder? @relation(fields: [relatedPoId], references: [id], onDelete: SetNull)

  recordedById String
  recordedBy   User     @relation("StockMovementRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)
  recordedAt   DateTime @default(now())

  @@index([schoolId])
  @@index([itemId])
  @@index([relatedPoId])
}

model Vendor {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([schoolId])
}

// status: Draft -> Ordered -> (PartiallyReceived | Received); Cancelled reachable from Draft/Ordered.
// PartiallyReceived/Received are only ever set by the receive flow (modules/inventory/service.ts#receivePo).
model PurchaseOrder {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  status       String    @default("Draft") // Draft | Ordered | PartiallyReceived | Received | Cancelled
  orderedAt    DateTime? @db.Date
  expectedDate DateTime? @db.Date
  notes        String?

  createdById String
  createdBy   User   @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines          PurchaseOrderLine[]
  stockMovements StockMovement[]

  @@index([schoolId])
  @@index([vendorId])
  @@index([schoolId, status])
}

model PurchaseOrderLine {
  id   String        @id @default(cuid())
  poId String
  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  quantityOrdered  Int
  quantityReceived Int    @default(0)
  unitCost         Float? // record-keeping/reporting only, not a ledger entry (Phase 17's job)

  @@index([poId])
  @@index([itemId])
}

// ───────────────────────────── Phase 17: accounting / general ledger ─────────────────────────────
// See phase-17-accounting.md. A conservative, correctness-first double-entry ledger: every JournalEntry
// must balance (sum(debit) === sum(credit) across its lines), enforced server-side inside a transaction
// (modules/accounting/service.ts#writeBalancedEntry) — never trust the caller, never write unbalanced.

model Account {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  code String // school-defined, e.g. "1000" — seeded with a sensible starter chart, admin can add more
  name String
  type String // Asset | Liability | Equity | Income | Expense

  parentId String? // simple hierarchy, e.g. Cash/Bank under a "Current Assets" parent
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[] @relation("AccountHierarchy")

  isSystem Boolean @default(false) // true for accounts the Fees/Payroll auto-posting integration relies
  // on (Bank, Fee Income, Salary Expense) — discourages deletion; service.ts blocks deleting an isSystem
  // account outright rather than merely warning, since the integration would silently break otherwise.
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines JournalLine[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, type])
}

// Posted immediately on creation in this phase — no draft/approval workflow, no edit/delete once created
// (a correction is a future reversing-entry feature — see phase-17-accounting.md's known limitation).
model JournalEntry {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  memo      String
  reference String? // free text, e.g. "Invoice INV-2026-042" or "Payroll Sept 2026"

  sourceType String // Manual | FeePayment | Payroll | Other
  sourceId   String? // polymorphic-by-convention id of the originating Payment/Payslip — not a real
  // Prisma relation (see phase-17-accounting.md's data model note)

  createdById String
  createdBy   User     @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  postedAt    DateTime @default(now())

  lines JournalLine[]

  @@index([schoolId])
  @@index([schoolId, date])
  @@index([schoolId, sourceType, sourceId])
}

model JournalLine {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  debit  Float @default(0) // exactly one of debit/credit is non-zero per line — enforced in schema.ts + service.ts
  credit Float @default(0)

  @@index([entryId])
  @@index([accountId])
}

// ───────────────────── Phase 18: syllabus & teaching progress tracking ─────────────────────
// See phase-18-syllabus-tracking.md. Syllabus lives on CurriculumSubject (board × grade × stream ×
// subject) — every class/section teaching that curriculum-subject inherits the same chapter list, but
// ChapterProgress is per ClassSubject so X-A and X-B can diverge in pace even though they share chapters.

model SyllabusChapter {
  id                  String            @id @default(cuid())
  schoolId            String
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  curriculumSubjectId String
  curriculumSubject   CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)
  order               Int
  title               String
  estimatedPeriods    Int
  examWeightagePct    Float?
  createdAt           DateTime          @default(now())

  progress    ChapterProgress[]
  resources   ChapterResource[]
  termTargets TermSyllabusTarget[]

  @@unique([curriculumSubjectId, order])
  @@index([schoolId])
}

// One row per (class-subject, chapter) — untouched chapters have no row and read as NotStarted (handled
// in the service, not the schema).
model ChapterProgress {
  id             String          @id @default(cuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject    @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  chapterId      String
  chapter        SyllabusChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status         String          @default("NotStarted") // NotStarted | InProgress | Done
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  updatedById    String
  updatedBy      User            @relation("ChapterProgressUpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())

  @@unique([classSubjectId, chapterId])
  @@index([schoolId])
}

// classId null = school-wide target for the curriculum-subject; a non-null classId overrides it for that
// one class. Postgres treats NULL as distinct in a unique index (same caveat as CurriculumSubject.streamId
// elsewhere), so the "one target per (curriculumSubject, term, class-or-school-wide)" rule is enforced in
// the service layer, not the DB constraint.
model TermSyllabusTarget {
  id                  String            @id @default(cuid())
  schoolId            String
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  curriculumSubjectId String
  curriculumSubject   CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)
  termId              String
  term                Term              @relation(fields: [termId], references: [id], onDelete: Cascade)
  targetChapterId     String
  targetChapter       SyllabusChapter   @relation(fields: [targetChapterId], references: [id], onDelete: Cascade)
  classId             String?
  class               Class?            @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([curriculumSubjectId, termId, classId])
  @@index([schoolId])
}

// The shared per-chapter teaching-resource library (lesson plans, worksheets, slides) — reuses the
// existing File upload infrastructure. Visible to every teacher who teaches that curriculum-subject
// anywhere in the school (enforced in service.ts, not schema).
model ChapterResource {
  id           String          @id @default(cuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  chapterId    String
  chapter      SyllabusChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  fileId       String
  file         File            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  label        String
  uploadedById String
  uploadedBy   User            @relation("ChapterResourceUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())

  @@index([schoolId])
  @@index([chapterId])
}

// ───────────────────────── Phase 19 — early warning & teaching analytics ─────────────────────────
// See phase-19-early-warning-analytics.md. A computed, periodically-refreshed snapshot (recomputed via
// POST /api/analytics/risk-snapshots/recompute) — deliberately NOT a live-query-every-time endpoint since
// the underlying formula reads across five modules (attendance, marks, homework, fees, discipline) and
// that fan-out would be slow to run on every dashboard page load at scale. `classId` is denormalized from
// the student's active enrollment at compute time (not a live join) so `GET ?classId=` can filter cheaply
// without re-deriving enrollment for every row. `factors` is the explainability breakdown the scoring
// formula documents in modules/analytics/service.ts — one row per weighted input with its actual
// contribution, so the UI can show "why" a student is flagged instead of a bare number.
model StudentRiskSnapshot {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   User    @relation("StudentRiskSnapshotStudent", fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  classId   String?
  class     Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  computedAt DateTime @default(now())

  attendancePct           Float
  avgMarksPct             Float
  homeworkOverdueCount    Int
  feeOverdueAmount        Float
  openDisciplineCaseCount Int

  riskScore Int // 0-100, higher = more at-risk
  riskLevel String // Low | Medium | High
  factors   Json // [{ factor, weight, contribution }] — see service.ts computeRiskScore()

  @@unique([studentId, termId])
  @@index([schoolId])
  @@index([classId])
  @@index([riskLevel])
}

// One row per school (same lazily-created-singleton convention as LibrarySettings — see
// modules/library/service.ts#getOrCreateSettings). `highLoadThreshold` backs item 3 (teacher workload
// balancing): the periods/week count above which the Timetable Builder shows a warning banner.
model AnalyticsSettings {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  highLoadThreshold Int @default(30)

  updatedAt DateTime @updatedAt
}

// ───────────────────────── Phase 21 — financial intelligence: formal scholarship program ─────────────────────────
// See phase-21-financial-intelligence.md item 4. `discountValue` is a percentage (0-100) when
// discountType is Percentage, or a currency amount when FixedAmount — interpreted in modules/scholarships.
model Scholarship {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  type          String // MeritBased | NeedBased | SiblingDiscount | StaffWard | Other
  discountType  String // Percentage | FixedAmount
  discountValue Float
  criteria      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  awards ScholarshipAward[]

  @@index([schoolId])
}

// Pending -> Approved | Rejected workflow (modules/scholarships/service.ts). On approval, the discount is
// actually applied to the student's fee invoices for the academic year by increasing FeeInvoice.concession
// (never the ledger directly — the GL only ever posts real payments, see accounting/service.ts, so a
// correctly-reduced invoice total is what keeps the auto-posted amount correct with zero extra wiring).
// `appliedToInvoiceIds` + `totalDiscountApplied` track exactly which invoices got how much, so a
// FixedAmount scholarship's remaining pool is known precisely across both the retroactive apply-on-approval
// pass and any later invoices generated for the same student/year (see fees/service.ts#generateInvoices).
model ScholarshipAward {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scholarshipId  String
  scholarship    Scholarship  @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  studentId      String
  student        User         @relation("ScholarshipAwardStudent", fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  status String  @default("Pending") // Pending | Approved | Rejected
  reason String? // free text, e.g. rejection reason

  proposedById String
  proposedBy   User      @relation("ScholarshipAwardProposedBy", fields: [proposedById], references: [id], onDelete: Cascade)
  approvedById String?
  approvedBy   User?     @relation("ScholarshipAwardApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  appliedToInvoiceIds  String[] @default([])
  totalDiscountApplied Float    @default(0)

  createdAt DateTime @default(now())

  @@unique([scholarshipId, studentId, academicYearId])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([status])
}

// ───────────────────────── Phase 22 — campus safety & security ─────────────────────────
// See phase-22-campus-safety.md. Item 1-2 live in modules/safety/; item 3 (very different, much
// stricter RBAC) lives in its own modules/counseling/ module — see that module's service.ts header for
// why it is not folded into modules/safety/ or modules/health/; item 4 extends modules/health/.

// Item 1 — per-student list of people allowed to collect them (managed by the parent/guardian or
// staff/admin). `relation` = the person's relation to the student (e.g. "Uncle", "Driver") — free text,
// same convention as Guardian.relation. `photoFileId` is a plain (unvalidated-at-DB-level) file id, same
// convention as User.photoFileId / HealthRecord.fileIds — checked against modules/files at write time.
model AuthorizedPickupPerson {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("AuthorizedPickupPersonStudent", fields: [studentId], references: [id], onDelete: Cascade)

  name        String
  relation    String
  phone       String
  photoFileId String?
  active      Boolean @default(true)

  addedById String
  addedBy   User     @relation("AuthorizedPickupPersonAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
}

// Item 1 — every pickup, logged by staff/gate-security. `otpRequired` is decided (and frozen) at creation
// time: pickupType EarlyOrUnlisted, or the collector isn't a currently-active AuthorizedPickupPerson for
// this student. `status`: PendingOtp (otpRequired, not yet verified — the "clearly flagged, not silently
// allowed through" state from the spec) -> Completed (verified, or otpRequired was false to begin with),
// or Flagged (an OTP was requested but expired / was never verified — an explicit failure state, distinct
// from the merely-waiting PendingOtp). The OTP code itself is never stored in plaintext (bcrypt hash,
// same as User.passwordHash) and expires quickly.
model PickupEvent {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("PickupEventStudent", fields: [studentId], references: [id], onDelete: Cascade)

  pickedUpByName     String
  pickedUpByRelation String
  pickupType         String @default("Regular") // Regular | EarlyOrUnlisted

  otpRequired   Boolean   @default(false)
  approvedByOtp Boolean   @default(false)
  otpCodeHash   String?
  otpExpiresAt  DateTime?
  otpVerifiedAt DateTime?
  otpAttempts   Int       @default(0)
  status        String    @default("Completed") // PendingOtp | Completed | Flagged

  recordedById String
  recordedBy   User     @relation("PickupEventRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)
  recordedAt   DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
}

// Item 2 — front-desk visitor check-in/checkout. `hostUserId` is who they're visiting (optional — a
// visitor may not be visiting a specific staff member).
model Visitor {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name    String
  phone   String
  purpose String

  hostUserId String?
  host       User?   @relation("VisitorHost", fields: [hostUserId], references: [id], onDelete: SetNull)

  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?
  badgeNo    String?

  recordedById String
  recordedBy   User   @relation("VisitorRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([checkInAt])
}

// Item 3 — confidential counseling. Deliberately MORE restricted than HealthRecord (visible to class
// teachers) and StaffConductRecord (HR/admin-only): visibility is the authoring counselor only, plus
// admin/superadmin ONLY if CounselingSettings.oversightEnabled is explicitly turned on for the school
// (default off — see modules/counseling/service.ts). Never the class teacher, never plain staff, never
// the student, never the parent.
model CounselingRecord {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("CounselingRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)

  counselorId String
  counselor   User   @relation("CounselingRecordCounselor", fields: [counselorId], references: [id], onDelete: Cascade)

  sessionDate    DateTime @db.Date
  notes          String
  category       String?
  followUpNeeded Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([counselorId])
}

// Per-school toggle for CounselingRecord oversight (see above). A dedicated one-row-per-school settings
// table, same convention as AnalyticsSettings / LibrarySettings — kept separate from School itself so it
// stays inside the Phase 22 cleanup block in admin/router.ts#reset.
model CounselingSettings {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  oversightEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// Item 3 — genuinely anonymous. No submittedById field, hidden or otherwise, anywhere on this model —
// see modules/counseling/service.ts#createAnonymousReport, which also takes care not to leak the
// submitter's identity into the audit() call for this row's creation.
model AnonymousReport {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  category    String // Bullying | Safety | Wellbeing | Other
  description String
  submittedAt DateTime @default(now())
  status      String   @default("New") // New | Reviewing | Resolved

  reviewedById    String?
  reviewedBy      User?   @relation("AnonymousReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolutionNotes String?

  @@index([schoolId])
  @@index([status])
}

// Item 4 — extends modules/health/ (Phase 8). A schedule + an administration log is a different concept
// from a one-off HealthRecord entry, so it's a new model, but RBAC/visibility reuses
// modules/health/service.ts#canViewHealth verbatim (student/guardians/class-teacher/staff/admin) — not
// reimplemented here.
model MedicationSchedule {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("MedicationScheduleStudent", fields: [studentId], references: [id], onDelete: Cascade)

  medicationName String
  dosage         String
  times          String[]  @default([]) // e.g. ["08:00", "14:00", "20:00"]
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  notes          String?

  addedById String
  addedBy   User     @relation("MedicationScheduleAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  logs MedicationLog[]

  @@index([schoolId])
  @@index([studentId])
}

model MedicationLog {
  id         String             @id @default(cuid())
  schoolId   String
  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  administeredAt   DateTime @default(now())
  administeredById String
  administeredBy   User     @relation("MedicationLogAdministeredBy", fields: [administeredById], references: [id], onDelete: Cascade)
  notes            String?

  @@index([schoolId])
  @@index([scheduleId])
}

// ───────────────────────── Phase 20 — AI-powered teaching & communication ─────────────────────────
// See phase-20-ai-teaching-communication.md item 2. A teacher-reviewed, explicitly-saved worksheet/question
// paper draft (the AI-generated draft itself, from POST /ai/generate-worksheet, is never persisted —
// only what a teacher deliberately saves via POST /ai/worksheets after reviewing/editing it). `content` is
// the reviewed markdown/plain-text body; `pdfFileId` is set lazily the first time a PDF is rendered for it
// (same bare-scalar convention as Certificate.pdfFileId — see modules/certificates, no Prisma relation to
// File declared).
model GeneratedWorksheet {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  chapterIds     String[]     @default([])
  title          String
  content        String
  pdfFileId      String?
  createdById    String
  createdBy      User         @relation("GeneratedWorksheetCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([schoolId])
  @@index([classSubjectId])
}

// ───────────────────────── Phase 23 — parent experience ─────────────────────────
// See phase-23-parent-experience.md item 2. Bookkeeping-only row so the daily "my child today" digest
// (POST /api/parents/digest/send-now, and whatever external scheduler eventually calls it once a day)
// never sends a parent two digests for the same calendar day — no digest content is persisted, just
// "this parent already got today's digest". `digestDate` is the YYYY-MM-DD the digest covers (server's
// local date at send time), not a timestamp, so the uniqueness check is a plain equality, not a range query.
model ParentDigestSend {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId   String
  parent     User     @relation("ParentDigestSendParent", fields: [parentId], references: [id], onDelete: Cascade)
  digestDate String // YYYY-MM-DD
  sentAt     DateTime @default(now())

  @@unique([parentId, digestDate])
  @@index([schoolId])
}

// ───────────────────────── Phase 25 — exam operations ─────────────────────────
// See phase-25-exam-operations.md. `Assessment` only ever carries a `date` (no period/time field — the
// existing model predates this phase and was not changed), so every "overlapping" check in this phase
// (elective clash detection in modules/assessments/service.ts, seating and invigilation here) operates at
// day granularity: two exams on the same calendar date are treated as concurrent. Documented at each call
// site rather than repeated here.

// assessmentIds: loose id array (same convention as Homework.attachments / Post.mediaFileIds) — one seating
// plan can bundle several assessments sharing a room + date (e.g. two different electives sitting in the
// same hall at once), so this is intentionally not a join table.
model ExamSeatingPlan {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessmentIds String[] @default([])
  date          DateTime @db.Date
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  generatedAt   DateTime @default(now())
  generatedById String?
  generatedBy   User?    @relation("ExamSeatingPlanGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  seats ExamSeat[]

  @@index([schoolId, date])
  @@index([roomId])
}

model ExamSeat {
  id           String          @id @default(cuid())
  planId       String
  plan         ExamSeatingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  studentId    String
  student      User            @relation("ExamSeatStudent", fields: [studentId], references: [id], onDelete: Cascade)
  seatNumber   Int
  assessmentId String
  assessment   Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([planId, seatNumber])
  @@index([planId])
  @@index([studentId])
  @@index([assessmentId])
}

model InvigilationDuty {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  roomId       String
  room         Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User       @relation("InvigilationDutyTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  status       String     @default("Assigned") // Assigned | Confirmed | Completed
  createdAt    DateTime   @default(now())

  @@index([schoolId, date])
  @@index([teacherId])
  @@index([assessmentId])
  @@index([roomId])
}

// ───────────────────────── Phase 28: multi-school / group management ─────────────────────────
// See phase-28-multi-school-group.md. Deliberately NOT a tenant boundary like School — a group has no
// classes/students/staff of its own, it is a thin read-only aggregation layer over 2+ real School tenants.
// Strict per-school data isolation is preserved everywhere else in the schema; this is the one addition
// that lets a single request legitimately touch more than one School's data (via N separate per-school
// queries combined in the group router — never a single query spanning schoolIds).

model SchoolGroup {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  schools School[]
  admins  GroupAdmin[]
}

// A user's grant of cross-school access to one SchoolGroup. `userId` deliberately has no relationship to
// group membership of that user's own `schoolId` — see the User.groupAdminGrants relation comment. Kept
// fully separate from the Ctx/requireRole() single-school scope system (server/src/lib/rbac.ts) that
// every other module depends on; only the new assertGroupAccess() helper reads this table.
model GroupAdmin {
  id        String      @id @default(cuid())
  groupId   String
  group     SchoolGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("GroupAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  role      String // 'GroupAdmin' | 'GroupViewer'
  createdAt DateTime    @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

// ───────────────────────── Phase 30: canteen prepaid wallet ─────────────────────────
// See phase-30-canteen-wallet.md. Ties into the real Phase 17 GL (modules/accounting/service.ts —
// postCanteenTopUpAutoEntry / postCanteenPurchaseAutoEntry, both funnelled through the one balanced-entry
// write path, writeBalancedEntry). Balance is stored as an integer PAISE running total (never a float,
// matching the GL's integer-cents comparison convention) — `WalletTransaction.amount` is the
// ledger-not-mutable-total pattern used elsewhere: balance is always re-derivable as the signed sum of a
// wallet's transactions, `StudentWallet.balance` is a maintained cache of that sum for cheap reads.
// Student QR/scan identifier: this codebase has no stable admission-number field on Enrollment (`rollNo`
// is per-academic-year and nullable) — per the phase spec's own guidance, we reuse `User.id` itself (the
// same "stable unique reference" every other module already keys students by) rather than adding a
// redundant new ID field. A canteen point-of-sale scans/enters that id directly (or an admin-issued QR
// encoding it, mirroring the `qrText` convention in modules/employeeDocuments/service.ts's ID-card PDF —
// no new QR library needed, none is added here since no PDF-rendering endpoint is in this phase's scope).
model StudentWallet {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @unique
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // integer paise, never negative (enforced in service.ts — no overdraft)
  pinHash   String? // optional PIN for in-person top-up/spend authorization — nullable, unused in v1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@index([schoolId])
}

model WalletTransaction {
  id               String        @id @default(cuid())
  schoolId         String
  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  walletId         String
  wallet           StudentWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type             String // TopUp | Purchase | Refund | Adjustment
  amount           Int // signed integer paise — positive for TopUp/Refund, negative for Purchase/Adjustment-down
  reason           String?
  itemsSummary     String? // free text, e.g. "2x Samosa, 1x Juice" — no full POS item-catalog model in v1
  recordedById     String?
  recordedBy       User?         @relation("WalletTransactionRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  occurredAt       DateTime      @default(now())
  relatedInvoiceId String? // unused in v1 — top-ups are a direct payment via the existing Payment Gateway
  // flow (see modules/canteen/service.ts#topUp), not a fee invoice; kept per the phase spec's data model
  // in case a future phase bills a top-up as a fee line item instead.

  @@index([schoolId])
  @@index([walletId, occurredAt])
}

// ───────────────────────── Phase T3 — sectioning engine ─────────────────────────
// See phase-t3-sectioning-engine.md (and advanced-timetable-roadmap.md D2/D5/D9). Builds on T1's Cohort —
// a "section" the engine assigns students into is always a Cohort id: for ordinary grade sectioning that's
// the auto-generated 1:1 SECTION cohort per Class (so a re-section literally moves Enrollment.classId,
// which is what "write section_id" cashes out to in this schema — there is no separate section_id column,
// Class already *is* board+grade+stream+section); for a track's Stage-2 merit sub-groups (JEE-A/JEE-B)
// it's an explicit multi-member TRACK-type Cohort with no backing Class, so membership is written to the
// new student-level CohortMembership junction instead. Entirely optional/decoupled — a school that never
// touches this module keeps working exactly as today (per the phase spec's own framing).

// §1 — neutral-label performance bands. Never auto-surfaced as "slow/average/topper" anywhere.
model PerformanceBand {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  label          String
  minScore       Float // inclusive, 0-100 percentage scale (see modules/sectioning/scoring.ts)
  maxScore       Float // inclusive
  createdAt      DateTime     @default(now())

  @@index([schoolId])
  @@index([academicYearId])
}

// §2 — a reusable, versioned recipe for one sectioning run. `scoreSource`/`subjectWeights` decide how a
// student's single 0-100 score is computed from real Phase 3 Assessment/Mark data (or T2's
// PriorSubjectScore for an external admit with no Mark history yet — see scoring.ts); `bandIds` selects
// which PerformanceBand rows define the mix; `sectionOrder` is the ordered list of target Cohort ids the
// strategy fills; `distributionConfig` carries strategy-specific knobs (tolerancePct, caps, skim spec, ...).
model SectioningTemplate {
  id                 String       @id @default(cuid())
  schoolId           String
  school             School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId     String
  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeId            String
  grade              Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  name               String
  strategy           String // BALANCED | RANKED | BANDED | STRATIFIED_CAPPED | RANDOM_PARITY | SKIM_THEN_BALANCE
  scoreSource        String // LATEST_EXAM | EXAM_AVERAGE | CUSTOM_WEIGHTING
  subjectWeights     Json? // { [subjectId]: weight } — only meaningful for CUSTOM_WEIGHTING
  bandIds            String[]     @default([])
  distributionConfig Json? // strategy-specific: tolerancePct, caps, skim[], remainderStrategy, broadGroups, siblingsTogether
  sectionOrder       String[]     @default([]) // Cohort ids, fill order
  respectExisting    Boolean      @default(true)
  createdAt          DateTime     @default(now())

  versions SectioningVersion[]

  @@index([schoolId])
  @@index([academicYearId])
  @@index([gradeId])
}

// §3 — track eligibility rule. `subjectScoreRules` shape: [{ subjectId?, subjectName?, minScore }] — a
// percentage (0-100) threshold checked against a continuing student's real Mark-derived subject % (by
// subjectId) or, for an external admit with no Mark history, T2's PriorSubjectScore (matched by
// subjectName) — see scoring.ts#evaluateSubjectRule. `enforcementMode` is a simple per-rule toggle (D5 —
// "as simple as that"), nothing more elaborate.
model TrackEligibilityRule {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  trackActivityId   String
  trackActivity     Activity @relation(fields: [trackActivityId], references: [id], onDelete: Cascade)
  label             String
  subjectScoreRules Json // [{ subjectId?, subjectName?, minScore }]
  enforcementMode   String // STRICT | ADVISORY
  createdAt         DateTime @default(now())

  @@index([schoolId])
  @@index([trackActivityId])
}

// Every eligibility exception this term — both an ADVISORY auto-flag (no reason/approver required) and a
// STRICT authorized override (reason + approver mandatory) land here, so the exceptions report (D5 —
// visibility, not policing) is a plain query, not an audit-log scrape. `type` distinguishes the two.
model TrackEligibilityException {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  trackActivityId String
  ruleId          String?
  studentId       String
  student         User     @relation("TrackEligibilityExceptionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  type            String // ADVISORY_FLAG | STRICT_OVERRIDE
  unmetDetails    Json // [{ subjectId?, subjectName?, minScore, actual }]
  reason          String? // mandatory (enforced in service.ts) for STRICT_OVERRIDE, unused for ADVISORY_FLAG
  approvedById    String?
  approvedBy      User?    @relation("TrackEligibilityExceptionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([schoolId])
  @@index([trackActivityId])
  @@index([studentId])
}

// §4 — one run of a template = one version. DRAFT until approved; approving writes the real
// Enrollment.classId / CohortMembership changes and flips status to APPROVED. `parentVersionId` gives a
// simple lineage (re-runs of the same template/scope chain together) and `diffSummary` stores a
// pre-computed before/after per student for display, matching this app's existing versioning conventions.
model SectioningVersion {
  id              String              @id @default(cuid())
  schoolId        String
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateId      String
  template        SectioningTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  scopeCohortId   String? // set for a Stage-2 run scoped to one track cohort's population; null = whole grade
  status          String              @default("DRAFT") // DRAFT | APPROVED | SUPERSEDED
  parentVersionId String?
  parentVersion   SectioningVersion?  @relation("SectioningVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   SectioningVersion[] @relation("SectioningVersionLineage")
  summary         Json // { scoredCount, unscoredStudentIds, warnings[], sectionBandMix, validation: {...} }
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?               @relation("SectioningVersionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  assignments SectioningAssignment[]

  @@index([schoolId])
  @@index([templateId])
}

model SectioningAssignment {
  id               String            @id @default(cuid())
  versionId        String
  version          SectioningVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId        String
  student          User              @relation("SectioningAssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  cohortId         String // target section Cohort id
  cohort           Cohort            @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  previousCohortId String? // for diffs — the section Cohort id the student was in immediately before this run, if any
  band             String?
  score            Float?
  createdAt        DateTime          @default(now())

  @@unique([versionId, studentId])
  @@index([versionId])
  @@index([schoolId])
  @@index([studentId])
}

// ───────────────────────── Phase T4 — Constraint Builder + solver core ─────────────────────────
// See .agents/edunova/phase-t4-solver-core.md. Purely additive on top of T1's Cohort/PeriodTemplate and
// the existing ClassSubject/TimetableEntry — the shipped Phase 26 auto-generator (modules/timetable/
// autogen.ts) keeps working completely unchanged; this phase adds a second, cohort-scoped generation path
// alongside it (modules/timetable/solver.ts), selected only when the caller passes `cohortIds`.

// §1 — a cohort's declared weekly teaching need for one subject, replacing the implicit
// ClassSubject.periodsPerWeek signal for schools that adopt Cohort/TeachingRequirement (existing
// ClassSubject rows are untouched and keep driving the legacy generator — see
// modules/timetable/teachingRequirements.ts#seedFromClassSubjects, which migrates the existing data in
// rather than asking a school to re-enter it).
model TeachingRequirement {
  id                     String   @id @default(cuid())
  schoolId               String
  school                 School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cohortId               String
  cohort                 Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  subjectId              String
  subject                Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  requiredPeriodsPerWeek Int
  sessionDuration        String   @default("SINGLE") // SINGLE | DOUBLE | TRIPLE | BLOCK
  roomRequirement        String   @default("ANY") // ANY | LAB_TYPE | SPECIFIC_ROOM
  specificRoomId         String?
  specificRoom           Room?    @relation(fields: [specificRoomId], references: [id], onDelete: SetNull)
  labDoubleAllowed       Boolean  @default(true)
  createdAt              DateTime @default(now())

  // Phase T5 §1 — which of the 4 assignment modes resolves this requirement's teacher. FIXED (default,
  // unchanged T4 behavior) keeps the admin-set TeachingAssignment as-is; POOL/RANDOM/OPTIMIZED are resolved
  // by modules/timetable/assignmentModes.ts, writing/replacing the same TeachingAssignment row so the
  // existing generation path (solver.ts) needs no changes to consume the result.
  assignmentMode String @default("FIXED") // FIXED | POOL | RANDOM | OPTIMIZED

  assignments TeachingAssignment[]
  pool        TeachingAssignmentPool[]

  // Phase T6 — which TimetableSession(s) this requirement's weekly need is satisfied by (a SharedSession
  // satisfies 2+ requirements — one per linked cohort — with ONE session), and which ElectiveOffering (if
  // any) wraps this requirement inside a grade-wide ElectiveBlock. See phase-t6-sessions-jobs.md §1/§1b.
  sessionLinks     SessionRequirement[]
  electiveOffering ElectiveOffering?

  @@unique([cohortId, subjectId])
  @@index([schoolId])
  @@index([cohortId])
}

// Phase T5 §1 — Mode 2 (Pool): admin-defined set of teachers eligible for one requirement. The solver
// (assignmentModes.ts) picks one member respecting every hard constraint, preferring lowest current
// workload as a placement-detail tiebreaker (not the full Mode 4 optimizer).
model TeachingAssignmentPool {
  id                    String              @id @default(cuid())
  schoolId              String
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachingRequirementId String
  teachingRequirement   TeachingRequirement @relation(fields: [teachingRequirementId], references: [id], onDelete: Cascade)
  teacherId             String
  teacher               User                @relation("TeachingAssignmentPoolTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())

  @@unique([teachingRequirementId, teacherId])
  @@index([schoolId])
  @@index([teachingRequirementId])
}

// §2 — Mode 1 (FIXED) only this phase: one teacher assigned directly to a requirement. Modes 2-4
// (Pool/Random/Optimized) are T5's job; the `@@unique([teachingRequirementId])` below is this phase's
// narrow "exactly one Fixed assignment per requirement" rule, relaxed when Pool mode is added.
model TeachingAssignment {
  id                    String              @id @default(cuid())
  schoolId              String
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachingRequirementId String
  teachingRequirement   TeachingRequirement @relation(fields: [teachingRequirementId], references: [id], onDelete: Cascade)
  teacherId             String
  teacher               User                @relation("TeachingAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  assignmentMode        String              @default("FIXED") // FIXED only, this phase
  selectionReason       String?
  createdAt             DateTime            @default(now())
  createdBy             String

  // Phase T6 — a TimetableSession's `teachingAssignmentId` optionally names the canonical (teacher,
  // requirement) pairing it materializes — see phase-t6-sessions-jobs.md §1.
  timetableSessions TimetableSession[]

  @@unique([teachingRequirementId])
  @@index([schoolId])
  @@index([teacherId])
}

// §3 — a real, queryable, school-configurable constraint row (data, not hardcoded logic — the Constraint
// Builder in modules/timetable/constraints.ts reads active rows of this table and applies them; it does
// not hardcode which constraints exist). `severity` is HARD only this phase (soft constraints/scoring are
// T5). `scope`/`scopeId` let a row apply school-wide or narrow to one cohort/teacher/room.
model Constraint {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type       String // TEACHER_COLLISION | ROOM_COLLISION | COHORT_COLLISION | TEACHER_AVAILABILITY | ROOM_CAPABILITY_MATCH | REQUIRED_WEEKLY_PERIODS | FIXED_SESSION
  scope      String   @default("SCHOOL") // SCHOOL | COHORT | TEACHER | ROOM
  scopeId    String?
  severity   String   @default("HARD") // HARD only this phase
  enabled    Boolean  @default(true)
  parameters Json     @default("{}")
  source     String   @default("SYSTEM") // SYSTEM | SCHOOL | MANUAL
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, type])
}

// ───────────────────────── Phase T5 — full assignment modes + soft constraints ─────────────────────────
// See .agents/edunova/phase-t5-full-solver.md. Purely additive on top of T1/T4: TeacherAvailability backs
// both Mode 4's availability scoring and the UNPREFERRED_SLOT soft-constraint penalty; Preference/
// PreferenceProfile turn T0's hardcoded example weights into real school-configurable data.

// A per-(teacher, day, period) availability declaration. No row at all for a given slot defaults to
// AVAILABLE (matches T1's original intent — a school only configures the exceptions). PREFERRED/
// NOT_PREFERRED feed both Mode 4's teacher-preference scoring and the refinement engine's
// UNPREFERRED_SLOT minor penalty; UNAVAILABLE is a hard constraint the solver must never place into.
model TeacherAvailability {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherAvailabilityTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1=Mon..6=Sat, matches TimetableEntry.dayOfWeek
  periodIdx Int
  status    String // AVAILABLE | UNAVAILABLE | PREFERRED | NOT_PREFERRED
  createdAt DateTime @default(now())

  @@unique([teacherId, dayOfWeek, periodIdx])
  @@index([schoolId])
  @@index([teacherId])
}

// §2/§3 — one configurable weight row per soft-constraint or assignment-scoring signal. `scope` separates
// the two use sites: REFINEMENT rows (weight applied within their `tier`'s W_HARD/MAJOR/WORKLOAD/MINOR
// band — see refinement.ts) feed the SA scorer; ASSIGNMENT rows feed Mode 4's per-teacher selection score
// (tier is meaningless there, always 0). Data, not hardcoded — seeded with T0's spike's own example weights
// as sensible defaults (seedDefaults, idempotent, mirrors constraints.ts#seedDefaults).
model Preference {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type       String // see refinement.ts REFINEMENT_TYPES / assignmentModes.ts ASSIGNMENT_TYPES
  scope      String // REFINEMENT | ASSIGNMENT
  weight     Float
  priority   Int      @default(0) // REFINEMENT: 1=major 2=workload 3=minor; ASSIGNMENT: always 0
  enabled    Boolean  @default(true)
  parameters Json     @default("{}")
  createdAt  DateTime @default(now())

  @@unique([schoolId, type])
  @@index([schoolId])
  @@index([schoolId, scope])
}

// §3 — a named, reusable starting set of REFINEMENT-scope weight overrides. A school selects one as
// `active`; the refinement engine merges `weightOverrides` on top of the school's base `Preference` rows
// (an override present here always wins; a type absent here falls back to the base row's weight).
model PreferenceProfile {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name            String // DEFAULT | BALANCED | TEACHER_FRIENDLY | STUDENT_FRIENDLY | EXAM_PREP | PRIMARY_SCHOOL | LAB_HEAVY
  description     String?
  weightOverrides Json // { [type]: weight }
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([schoolId, name])
  @@index([schoolId])
}

// ───────────────────────── Phase T6 — sessions, generation jobs, diagnostics ─────────────────────────
// See .agents/edunova/phase-t6-sessions-jobs.md. Wraps T4/T5's working solver core (TeachingRequirement/
// TeachingAssignment/Constraint/generateForCohorts/refineDraft, all unchanged) in the session/job model the
// original spec described. TimetableEntry (D3) stays the real, populated compatibility table every existing
// consumer reads — every TimetableSessionEntry still materializes into it, this phase just formalizes
// TimetableSession as the layer that documents WHAT was generated/declared and WHY, on top of the same
// materialized-write path (service.ts#replaceGrid/validateGrid) T4's commit already used.

// §1 — one scheduled occurrence. A SINGLE/DOUBLE/etc. session normally belongs to exactly one cohort (one
// SessionCohort row, one SessionRequirement row); a SharedSession is the SAME kind of row with 2+
// SessionCohort/SessionRequirement rows — it satisfies EVERY linked cohort's requirement for that slot and
// is never treated as a collision between them (see modules/timetable/sessions.ts#materializeSession, which
// writes one TimetableEntry per underlying Class every linked cohort touches, all sharing this session's
// single teacher/room/period — exactly D3's "12-A + 12-B combined English" example).
model TimetableSession {
  id                   String                  @id @default(cuid())
  schoolId             String
  school               School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId               String
  term                 Term                    @relation(fields: [termId], references: [id], onDelete: Cascade)
  subjectId            String
  subject              Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teachingAssignmentId String?
  teachingAssignment   TeachingAssignment?     @relation(fields: [teachingAssignmentId], references: [id], onDelete: SetNull)
  teacherId            String?
  teacher              User?                   @relation("TimetableSessionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  roomId               String?
  room                 Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sessionType          String                  @default("SINGLE") // SINGLE|DOUBLE|TRIPLE|LAB_BLOCK|ASSEMBLY|LUNCH|ACTIVITY|STUDY|FREE|SHARED|FIXED
  durationPeriods      Int                     @default(1)
  isSplittable         Boolean                 @default(false)
  timetableVersionId   String? // reserved for T7 versioning (no TimetableVersion table exists yet)
  jobId                String? // the TimetableGenerationJob that produced this session, if any (explicit
  job                  TimetableGenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull) // admin-declared SharedSessions/ElectiveOfferings have no job)
  createdById          String
  createdBy            User                    @relation("TimetableSessionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt            DateTime                @default(now())
  committedAt          DateTime? // set once materializeSession has written its TimetableEntry rows

  entries             TimetableSessionEntry[]
  cohorts             SessionCohort[]
  requirements        SessionRequirement[]
  electiveOffering    ElectiveOffering?
  materializedEntries TimetableEntry[]

  @@index([schoolId])
  @@index([schoolId, termId])
  @@index([jobId])
}

// One row per period a session occupies (durationPeriods=2 → 2 rows on the same day, contiguous periods).
model TimetableSessionEntry {
  id        String           @id @default(cuid())
  sessionId String
  session   TimetableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  periodIdx Int
  createdAt DateTime         @default(now())

  @@unique([sessionId, dayOfWeek, periodIdx])
  @@index([sessionId])
}

// A session with 2+ rows here is a genuine SharedSession (§1) — every linked cohort's own
// TeachingRequirement for the session's subject is satisfied by this ONE session, not by independent
// per-cohort sessions that happen to share a slot (that would reintroduce the false-positive collision the
// original spec warns about, since two truly independent sessions at the same slot for different cohorts
// that happen to share a teacher ARE a real conflict — SharedSession is the deliberate exception).
model SessionCohort {
  id        String           @id @default(cuid())
  sessionId String
  session   TimetableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cohortId  String
  cohort    Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([sessionId, cohortId])
  @@index([cohortId])
}

// Which TeachingRequirement(s) this session counts against, for "remaining need" bookkeeping — a normal
// session has exactly one; a SharedSession has one per linked cohort (each cohort's OWN requirement for the
// same subject, e.g. 12-A's English requirement AND 12-B's English requirement, both satisfied by this one
// session's periods).
model SessionRequirement {
  id                    String              @id @default(cuid())
  sessionId             String
  session               TimetableSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teachingRequirementId String
  teachingRequirement   TeachingRequirement @relation(fields: [teachingRequirementId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())

  @@unique([sessionId, teachingRequirementId])
  @@index([teachingRequirementId])
}

// §1b — a grade-wide reserved slot where N parallel elective offerings run at once so students can choose
// between them without a schedule clash. NOT a SharedSession (which merges cohorts into one session) — the
// inverse: one slot, multiple parallel sessions, students individually bucketed by choice.
model ElectiveBlock {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId          String
  term            Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  gradeId         String
  grade           Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  name            String
  dayOfWeek       Int
  periodIdx       Int
  durationPeriods Int      @default(1)
  createdById     String
  createdBy       User     @relation("ElectiveBlockCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  offerings ElectiveOffering[]

  @@index([schoolId])
  @@index([schoolId, termId])
}

// One elective subject offered within a block, e.g. "Psychology" vs "Fine Arts" both offered at the same
// grade-wide slot. Each offering wraps its own TeachingRequirement (scoped to an ELECTIVE-type Cohort whose
// student-level membership, via CohortMembership, is exactly the students who chose it — populated from
// ElectiveChoice below, mirroring T3's Activity-registration→CohortMembership pattern) and, once a
// teacher/room is resolved, its own TimetableSession locked to the block's exact day/period.
model ElectiveOffering {
  id                    String              @id @default(cuid())
  electiveBlockId       String
  electiveBlock         ElectiveBlock       @relation(fields: [electiveBlockId], references: [id], onDelete: Cascade)
  teachingRequirementId String              @unique
  teachingRequirement   TeachingRequirement @relation(fields: [teachingRequirementId], references: [id], onDelete: Cascade)
  sessionId             String?             @unique
  session               TimetableSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  capacity              Int?
  createdAt             DateTime            @default(now())

  choices ElectiveChoice[]

  @@index([electiveBlockId])
}

// Which student picked which elective offering — the T3 Activity/ActivityRegistration shape, reused
// (status default "Registered", same convention), scoped here to elective offerings rather than the general
// club/house/event Activity catalog since offerings are tied to TeachingRequirement/Cohort, not Activity.
model ElectiveChoice {
  id                 String           @id @default(cuid())
  electiveOfferingId String
  electiveOffering   ElectiveOffering @relation(fields: [electiveOfferingId], references: [id], onDelete: Cascade)
  studentId          String
  student            User             @relation("ElectiveChoiceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status             String           @default("Registered") // Registered | Waitlisted | Cancelled
  registeredAt       DateTime         @default(now())

  @@unique([electiveOfferingId, studentId])
  @@index([electiveOfferingId])
  @@index([studentId])
}

// §3 — TimetableGenerationJob: wraps T4/T5's existing generateForCohorts→refineDraft pipeline as a
// first-class, reproducible object rather than a bare request/response. For the realistic problem sizes T0
// benchmarked (single-grade generation in low single-digit seconds), the job runs synchronously within the
// request that creates it — status/progress/currentStage are still recorded faithfully (QUEUED is skipped;
// the row transitions BUILDING_MODEL→SOLVING→VALIDATING→COMPLETED|FAILED in place before the response
// returns) so the SAME row shape is ready for genuine async execution later without a breaking change.
model TimetableGenerationJob {
  id                 String       @id @default(cuid())
  schoolId           String
  school             School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId     String
  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId             String
  term               Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  scopeCohortIds     Json // string[]
  status             String       @default("QUEUED") // QUEUED|BUILDING_MODEL|SOLVING|VALIDATING|COMPLETED|FAILED|CANCELLED
  progress           Int          @default(0) // 0-100
  currentStage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  solverVersion      String // e.g. "t4-greedy+t5-sa@1" — bumped whenever generateForCohorts/refineDraft's
  // actual algorithm changes, so an old job's reproducibility claim is honestly scoped to "same solver version".
  timeLimit          Int // ms SA budget per cohort-group, mirrors refineBody.timeBudgetMsPerGroup
  inputSnapshot      Json // { cohortIds, mode, requirementIds, requirementFingerprint } — see jobs.ts
  constraintSnapshot Json // the active Constraint rows at generation time (type/scope/parameters/enabled)
  preferenceSnapshot Json // the active Preference rows + active/selected PreferenceProfile at generation time
  randomSeed         Int
  solverParameters   Json         @default("{}") // { timeBudgetMsPerGroup }
  resultVersionId    String? // reserved for T7 versioning; no TimetableVersion table exists yet
  outputHash         String? // sha256 of the canonicalized post-refinement draft — reproducibility check
  draftEntries       Json? // the generated (post-refinement) draft, stored so /commit and reproducibility
  // diffing don't require re-running generation
  diagnostics        Json? // structured infeasibility diagnostics (see diagnostics.ts) — null when feasible
  errorCode          String? // e.g. "INFEASIBLE" | "NO_COHORTS" | "INTERNAL"
  errorDetails       Json?
  createdById        String
  createdBy          User         @relation("TimetableGenerationJobCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now())

  sessions       TimetableSession[]
  resultVersions TimetableVersion[]

  @@index([schoolId])
  @@index([schoolId, termId])
}

// ───────────────────────── Phase T7 — versioning + locks + a real override system ─────────────────────────
// See phase-t7-versioning-override.md (roadmap D10 — this is the centerpiece of the whole Advanced
// Timetable Generation project: it's what makes retiring Phase 26's simple generator in T10 acceptable).
//
// Design note (why a version's own entries live in a JSON snapshot, not always as real TimetableEntry
// rows): the pre-existing TimetableEntry table has `@@unique([classId, termId, dayOfWeek, periodIdx])` —
// only one row can occupy a given class/term/slot at all, regardless of version. That is exactly right for
// D3 (TimetableEntry is the single materialized "what's actually live" compatibility layer every existing
// consumer reads). It also means a DRAFT/MODIFIED version being hand-edited cannot coexist, slot-for-slot,
// with the currently-PUBLISHED version's own live rows in that same table — so, matching the pattern T4/T6
// already established for in-progress generation (TimetableGenerationJob.draftEntries is a JSON snapshot,
// never written to TimetableEntry until commit), a TimetableVersion always carries its own full `entries`
// snapshot; only a PUBLISHED version's snapshot is ever materialized into real, live TimetableEntry rows
// (tagged with timetableVersionId), and only at the moment it becomes PUBLISHED. This is what makes
// enforced immutability tractable: a PUBLISHED version's live rows are written exactly once and never
// updated/deleted in place again — superseding it always means publishing a NEW version (parent = the old
// one), which replaces the live rows and flips the old version to ARCHIVED; the old version's OWN `entries`
// snapshot is untouched by that and stays queryable forever, satisfying "old version stays archived intact".
model TimetableVersion {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)

  // Scope: a version governs either a set of cohorts (the T4+ solver-scoped path) or a flat set of classes
  // (the pre-cohort Phase 2 manual-edit path this phase upgrades in place) — whichever the caller used to
  // create it. Both default to `[]`, additive/optional so nothing pre-T7 needs either.
  scopeCohortIds Json @default("[]") // string[]
  scopeClassIds  Json @default("[]") // string[]

  status String @default("DRAFT") // DRAFT|GENERATED|MODIFIED|APPROVED|PUBLISHED|ARCHIVED

  parentVersionId String?
  parentVersion   TimetableVersion?  @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children        TimetableVersion[] @relation("VersionLineage")

  generationJobId String? // the TimetableGenerationJob that produced this version's initial entries, if any
  generationJob   TimetableGenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  changeReason String? // why this version was created as a modification of its parent (§1)

  // The version's own full entry snapshot: { classId, dayOfWeek, periodIdx, classSubjectId, roomId,
  // teacherId, sessionId }[] — the source of truth for this version regardless of whether it is currently
  // materialized live. Kept in sync by every override action (§4) that touches this version while it is
  // still editable (DRAFT/GENERATED/MODIFIED).
  entries Json

  // Computed once at creation time when parentVersionId is set (manual fork, or a future T8 partial-
  // reoptimization result) — { added: Entry[], removed: Entry[], changed: { before: Entry, after: Entry }[] }
  // — so "what changed vs. the version this replaces" never requires a full-entry-set diff on demand (§1).
  diffFromParent Json?

  publishedAt DateTime?
  archivedAt  DateTime?

  createdById String
  createdBy   User     @relation("TimetableVersionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  locks        TimetableLock[]
  editEvents   TimetableEditEvent[]
  materialized TimetableEntry[] // live rows this version currently owns (only ever non-empty while PUBLISHED)

  @@index([schoolId, termId])
  @@index([schoolId, status])
  @@index([parentVersionId])
  @@index([generationJobId])
}

// A generic lock, exactly per the spec's own examples of how the granularities differ: a whole-DAY lock
// (targetId null, dayOfWeek set) is a different, broader constraint than a specific TEACHER lock (targetId
// = teacherId, day/period null — that teacher untouchable anywhere in this version) which is itself
// different from one exact slot's ASSIGNMENT lock (targetId = classSubjectId, both day/period set). T8
// (not this phase) is what makes every lock type actually respected mid-solve; this phase's solver
// integration is intentionally minimal (see solver.ts/refinement.ts — full-regenerate/refine skip anything
// in an active lock's scope) and the override system (§4) always blocks a hand-edit into a locked target.
model TimetableLock {
  id                 String           @id @default(cuid())
  schoolId           String
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableVersionId String
  version            TimetableVersion @relation(fields: [timetableVersionId], references: [id], onDelete: Cascade)

  lockType   String // SESSION|TEACHER|ROOM|COHORT|DAY|PERIOD|ASSIGNMENT
  targetType String // what targetId names: sessionId|teacherId|roomId|cohortId|classSubjectId|none (DAY/PERIOD-only locks)
  targetId   String?
  dayOfWeek  Int? // set for DAY/PERIOD/ASSIGNMENT-style slot-scoped locks
  periodIdx  Int? // set for PERIOD/ASSIGNMENT-style slot-scoped locks

  reason String?

  createdById String
  createdBy   User     @relation("TimetableLockCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  releasedAt   DateTime? // set by unlock (§4) — rows are kept, not deleted, so a lock's own history is auditable
  releasedById String?

  @@index([schoolId, timetableVersionId])
  @@index([timetableVersionId, lockType])
}

// Per-version, ordered hand-edit log with real before/after entry snapshots — this is what makes Undo
// (§4: at minimum last-change, and here also revert-to-any-prior-point) a real replay rather than a hope.
// Every row here is written alongside (never instead of) a normal audit() call to the school's generic
// AuditLog — this table exists purely to carry the structured diff undo needs; AuditLog stays the single
// inspectable "who/when/what/why" record every override produces, exactly per the ground rules.
model TimetableEditEvent {
  id                 String           @id @default(cuid())
  schoolId           String
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableVersionId String
  version            TimetableVersion @relation(fields: [timetableVersionId], references: [id], onDelete: Cascade)

  seq    Int // 1-based, increasing per version — the undo/redo ordering
  action String // MOVE|SWAP|LOCK|UNLOCK|REGENERATE_SLOT|UNDO

  before Json // the affected entries' state immediately before this action (possibly [])
  after  Json // the affected entries' state immediately after this action (possibly [])

  reason String?

  createdById String
  createdBy   User     @relation("TimetableEditEventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  undone   Boolean   @default(false) // true once a later UNDO has reverted this event
  undoneAt DateTime?

  @@unique([timetableVersionId, seq])
  @@index([schoolId, timetableVersionId])
}

// ───────────────────────── Phase T9 — Substitution Workflow ─────────────────────────
// See .agents/edunova/phase-t9-substitution.md and roadmap D6. Extends the existing Phase 6 LeaveRequest
// (new "PENDING_SUBSTITUTION" status value, added as a plain string — LeaveRequest.status was never a DB
// enum, just a documented convention, so no column change was needed there) rather than forking a parallel
// leave model. The Substitute Finder (modules/timetable/substitution.ts) reuses T4's Constraint model
// (activeTypes) plus the same TeacherQualification/TeacherAvailability/TimetableEntry primitives every
// other T4/T5/T8 solver file queries directly — there is no shared "checkCollision()" function to import in
// this codebase; each consumer applies the same active-constraint-type gate to its own domain queries, and
// this phase follows that exact convention rather than inventing a new abstraction.
//
// Design note on PeriodHold vs TimetableLock (required by the phase spec): kept SEPARATE, not merged.
// TimetableLock protects a slot within ONE TimetableVersion's editable draft (day-of-week/recurring-
// template semantics — "this slot, every week, in this draft"), and its LOCKED-vs-not is binary with no
// TENTATIVE concept. PeriodHold guards a substitute TEACHER's real-world availability for a specific
// CALENDAR DATE (not a version draft, not day-of-week-recurring — a substitution is a one-off exception,
// exactly why the pre-existing Substitution model already keyed off `date` rather than a recurring
// TimetableEntry-style day-of-week), and it has a genuine two-stage lifecycle (TENTATIVE on accept, LOCKED
// only on the teacher's leave being approved — D6's core invariant) that TimetableLock was never designed
// to express. Reusing TimetableLock would mean bolting a TENTATIVE state and a calendar-date scope onto a
// model whose every other consumer (T7 override system, T8 what-if) assumes version-draft/day-of-week
// semantics — a worse fit than a small, purpose-built table.

// One row per school (a singleton, `schoolId` unique) — the D6 policy configuration. No row at all defaults
// to TEACHER_INITIATED / 12h notice / cross-subject substitution disabled / 4h tentative-hold expiry (see
// substitution.ts#effectivePolicy), matching this codebase's existing "absence of a row = the documented
// default" convention (e.g. TeacherAvailability, WorkingDayPattern).
model SubstitutionPolicy {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  mode                          String  @default("TEACHER_INITIATED") // TEACHER_INITIATED | ADMIN_ASSIGNED | HYBRID
  minNoticeHoursForSubstitution Int     @default(12)
  allowCrossSubject             Boolean @default(false)
  maxWeeklySubstitutePeriods    Int     @default(30) // hard workload cap the Finder excludes candidates over
  tentativeHoldExpiryMinutes    Int     @default(240)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// One configurable weight row per Finder ranking signal — mirrors T5's Preference(scope='ASSIGNMENT')
// pattern exactly (see assignmentModes.ts), just a distinct `scope` value so the two tables never collide:
// PATCH /preferences/:type (existing T5 endpoint) already works against this table unmodified since scope
// is just another string value it accepts.

// §2 — a teacher's absence, decomposed into the specific covered periods a substitute is sought for.
// `periods` is { date, dayOfWeek, periodIdx, timetableEntryId, classId, classSubjectId, subjectName }[] —
// captured once at send time so a later change to the underlying TimetableEntry can never retroactively
// alter what a substitute actually agreed to cover.
model SubstitutionRequest {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  originalTeacherId   String
  originalTeacher     User   @relation("SubstitutionRequestOriginalTeacher", fields: [originalTeacherId], references: [id], onDelete: Cascade)
  substituteTeacherId String
  substituteTeacher   User   @relation("SubstitutionRequestSubstituteTeacher", fields: [substituteTeacherId], references: [id], onDelete: Cascade)

  periods Json // see doc comment above

  status String @default("SENT") // SENT | ACCEPTED | DECLINED | EXPIRED

  // Which policy path produced this row (§1/§5) — TEACHER_INITIATED/HYBRID go through SENT->accept;
  // ADMIN_ASSIGNED and EMERGENCY (minimum-notice routing) are created directly ACCEPTED, no round-trip.
  mode String // TEACHER_INITIATED | ADMIN_ASSIGNED | HYBRID | EMERGENCY

  score        Float? // Finder's ranking score for this candidate at send time (admin visibility, §2)
  isOverride   Boolean @default(false) // §4 — admin forced a soft-constraint-failing candidate through
  overrideNote String?

  sentById String
  sentBy   User     @relation("SubstitutionRequestSentBy", fields: [sentById], references: [id], onDelete: Cascade)
  sentAt   DateTime @default(now())

  decidedById String?
  decidedBy   User?     @relation("SubstitutionRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  declinedAt  DateTime?
  expiredAt   DateTime?

  createdAt DateTime @default(now())

  holds PeriodHold[]

  @@index([schoolId])
  @@index([leaveRequestId])
  @@index([substituteTeacherId, status])
  @@index([originalTeacherId])
}

// §3 — the race-condition guard. One row per (substitute teacher, calendar date, period) a SubstitutionRequest
// currently holds. TENTATIVE the moment a substitute accepts; promoted to LOCKED only when the teacher's
// leave is actually admin-approved (D6's invariant — never before); auto-expires (see substitution.ts#
// expireStaleHolds, called lazily wherever this codebase already calls opportunistic expiry checks — see
// leave/service.ts#deactivateIfPastLastWorkingDate for the exact precedent this follows) after
// `SubstitutionPolicy.tentativeHoldExpiryMinutes` if still TENTATIVE, so a dead request can't block a
// teacher's real availability indefinitely.
model PeriodHold {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("PeriodHoldTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  dayOfWeek Int
  periodIdx Int
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)

  holdType String // TENTATIVE | LOCKED

  sourceSubstitutionRequestId String?
  sourceSubstitutionRequest   SubstitutionRequest? @relation(fields: [sourceSubstitutionRequestId], references: [id], onDelete: SetNull)

  expiresAt  DateTime? // set for TENTATIVE holds only; null once promoted to LOCKED
  releasedAt DateTime? // set on expiry, decline, or supersession — rows are kept, mirrors TimetableLock's own releasedAt convention

  createdAt DateTime @default(now())

  // A substitute can be TENTATIVE- or LOCKED-held at most once per (teacher, date, period) among ACTIVE
  // (releasedAt null) rows — enforced in substitution.ts (a DB-level partial-unique-index would need raw
  // SQL this codebase's migration convention avoids elsewhere; every other race-guard here, e.g.
  // Contract/Resignation's "already pending" checks, is likewise enforced in the service layer).
  @@index([schoolId])
  @@index([teacherId, date, periodIdx])
  @@index([sourceSubstitutionRequestId])
}
