DATABASE_URL="postgresql://edunova:edunova_dev_pw@localhost:5434/edunova?schema=public"
JWT_SECRET="edunova_dev_jwt_secret_change_me"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Structured request/app logging (server/src/lib/logger.ts, pino). Optional — defaults to "info".
# LOG_LEVEL=info

# Note: access-token (15m) and refresh-token (30d) lifetimes are constants in server/src/auth.ts
# (ACCESS_TOKEN_TTL / REFRESH_TOKEN_TTL_MS), not env-driven — nothing to set here for those.

# Phase 9 — all optional. Each feature degrades gracefully (logs/no-ops) when its var is unset.
# AI Doubt Clearing (POST /api/ai/ask) — without this the endpoint returns "AI tutor not configured".
# ANTHROPIC_API_KEY=

# Outbound email/SMS — without either of these, lib/notify.ts falls back to a console-log provider.
# RESEND_API_KEY=
# MSG91_API_KEY=

# PWA push (web-push) — generate with `npx web-push generate-vapid-keys`. Without all three, push is a no-op.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:admin@edunova.in"
